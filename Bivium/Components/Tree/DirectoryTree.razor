@namespace Bivium.Components.Tree
@implements IAsyncDisposable
@using System
@using System.Collections.Generic
@using System.IO
@using System.Linq
@using System.Threading.Tasks
@inject Bivium.Services.IFileSystemService FileSystemService
@inject IJSRuntime JSRuntime

<div @ref="this._host" class="bivium-tree-host">
    <RadzenTree class="bivium-directory-tree" Value="@this._currentPath" AriaLabel="Directory tree"
                Expand="this.HandleExpandAsync" Collapse="this.HandleCollapseAsync" Change="this.HandleChangeAsync">
        @this.RenderNodes(this._roots)
    </RadzenTree>
</div>

@code {
    /// <summary>
    /// Percorso attualmente aperto nel pannello
    /// </summary>
    [Parameter]
    public string CurrentPath { get; set; } = "";

    /// <summary>
    /// Percorsi semantici dei nodi espansi
    /// </summary>
    [Parameter]
    public HashSet<string> ExpandedDirectoryPaths { get; set; } = new HashSet<string>();

    /// <summary>
    /// Contenuto già caricato della directory corrente: un nuovo elenco segue navigazione, refresh e operazioni
    /// </summary>
    [Parameter]
    public List<FileSystemEntry> Entries { get; set; }

    /// <summary>
    /// Notifica una richiesta di navigazione
    /// </summary>
    [Parameter]
    public EventCallback<string> OnDirectorySelected { get; set; }

    /// <summary>
    /// Notifica una modifica dello stato di espansione
    /// </summary>
    [Parameter]
    public EventCallback<DirectoryTreeExpansionChange> OnExpansionChanged { get; set; }

    /// <summary>
    /// Radici filesystem visualizzate dal tree
    /// </summary>
    private List<DirectoryTreeItem> _roots = new List<DirectoryTreeItem>();

    /// <summary>
    /// Snapshot di espansione usato esclusivamente dalla proiezione UI
    /// </summary>
    private HashSet<string> _expandedPaths = new HashSet<string>();

    /// <summary>
    /// Espansioni automatiche ancora da inoltrare al proprietario
    /// </summary>
    private HashSet<string> _pendingExpansions = new HashSet<string>();

    /// <summary>
    /// Percorso normalizzato osservato nell'ultimo render
    /// </summary>
    private string _currentPath = "";

    /// <summary>
    /// Nodo selezionato nella gerarchia della radice filesystem
    /// </summary>
    private DirectoryTreeItem _selectedNode;

    /// <summary>
    /// Ultimo elenco del pannello proiettato sui figli del nodo corrente
    /// </summary>
    private List<FileSystemEntry> _projectedEntries;

    /// <summary>
    /// Stato transitorio del caricamento e dello scroll
    /// </summary>
    private bool _initialized, _scrollPending, _publishingExpansions, _isDisposed;

    /// <summary>
    /// Host DOM e modulo stateless dello scroll locale
    /// </summary>
    private ElementReference _host;
    private IJSObjectReference _jsModule;

    /// <summary>
    /// Import condiviso tra render sovrapposti e atteso anche dal cleanup
    /// </summary>
    private Task<IJSObjectReference> _moduleImport;

    /// <summary>
    /// Proietta l'icona directory e il percorso completo lasciando a Radzen gli eventi del nodo
    /// </summary>
    private RenderFragment<RadzenTreeItem> DirectoryTemplate => item => @<span class="bivium-tree-name" title="@item.Value" data-directory-path="@item.Value">
        <RadzenIcon Icon="folder" aria-hidden="true" /><span>@item.Text</span>
    </span>;

    /// <summary>
    /// Riproietta lo snapshot e rivela gli antenati soltanto al cambio percorso
    /// </summary>
    protected override void OnParametersSet()
    {
        bool initializeUnixRoot = !this._initialized && !OperatingSystem.IsWindows();
        if (!this._initialized)
        {
            this._initialized = true;
            if (OperatingSystem.IsWindows())
            {
                this._roots = this.FileSystemService.GetDriveRoots().OrderBy(entry => entry.Name, StringComparer.OrdinalIgnoreCase).Select(entry => new DirectoryTreeItem(entry)).ToList();
            }
            else
            {
                FileSystemEntry root = this.FileSystemService.GetEntryInfo("/");
                if (root.IsDirectory && !string.IsNullOrEmpty(root.FullPath))
                {
                    root.Name = "/";
                    this._roots.Add(new DirectoryTreeItem(root));
                }
            }
        }

        StringComparer comparer = this.GetPathComparison() == StringComparison.Ordinal ? StringComparer.Ordinal : StringComparer.OrdinalIgnoreCase;
        this._expandedPaths = new HashSet<string>(this.ExpandedDirectoryPaths.Select(this.NormalizePath), comparer);
        this._expandedPaths.UnionWith(this._pendingExpansions);
        if (initializeUnixRoot && this._roots.Count > 0 && this._expandedPaths.Add(this._roots[0].FullPath))
            this._pendingExpansions.Add(this._roots[0].FullPath);
        string path = this.NormalizePath(this.CurrentPath);
        if (!string.Equals(path, this._currentPath, this.GetPathComparison()))
        {
            this._currentPath = path;
            this.RevealCurrentPath();
            this._scrollPending = true;
        }
        if (!ReferenceEquals(this.Entries, this._projectedEntries))
        {
            this._projectedEntries = this.Entries;
            this.RefreshCurrentChildren();
        }
        this.LoadExpandedBranches(this._roots);
    }

    /// <summary>
    /// Pubblica le richieste automatiche e scorre senza spostare il focus DOM
    /// </summary>
    /// <param name="firstRender">True al primo render interattivo</param>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (this._isDisposed)
            return;

        if (!this._publishingExpansions)
        {
            this._publishingExpansions = true;
            try
            {
                foreach (string path in this._pendingExpansions.ToArray())
                {
                    if (this._pendingExpansions.Contains(path))
                        await this.OnExpansionChanged.InvokeAsync(new DirectoryTreeExpansionChange { Path = path, Expanded = true });
                    this._pendingExpansions.Remove(path);
                }
            }
            finally
            {
                this._publishingExpansions = false;
            }
        }

        if (this._scrollPending && !this._isDisposed)
        {
            this._scrollPending = false;
            if (this._jsModule == null)
            {
                if (this._moduleImport == null)
                    this._moduleImport = this.JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/directory-tree.js").AsTask();
                IJSObjectReference module = await this._moduleImport;
                if (this._isDisposed)
                    return;
                this._jsModule = module;
            }
            if (!this._isDisposed)
            {
                string path = this._selectedNode?.FullPath ?? this._currentPath;
                bool revealed = await this._jsModule.InvokeAsync<bool>("revealDirectory", this._host, path);
                if (string.Equals(path, this._currentPath, this.GetPathComparison()))
                    this._scrollPending = !revealed;
            }
        }
    }

    /// <summary>
    /// Materializza il ramo richiesto senza delegare a Radzen identità dei data item
    /// </summary>
    /// <param name="args">Nodo richiesto da Radzen</param>
    private async Task HandleExpandAsync(TreeExpandEventArgs args)
    {
        string path = args.Value as string ?? "";
        DirectoryTreeItem node = this.FindNode(this._roots, path);
        if (node == null)
            return;
        bool wasExpanded = this._expandedPaths.Contains(path);
        this.LoadChildren(node, !wasExpanded);
        if (this._expandedPaths.Add(path))
            await this.OnExpansionChanged.InvokeAsync(new DirectoryTreeExpansionChange { Path = path, Expanded = true });
    }

    /// <summary>
    /// Inoltra al proprietario la compressione di un nodo
    /// </summary>
    /// <param name="args">Nodo compresso da Radzen</param>
    private async Task HandleCollapseAsync(TreeEventArgs args)
    {
        string path = args.Value as string ?? "";
        this._pendingExpansions.Remove(path);
        if (this._expandedPaths.Remove(path))
            await this.OnExpansionChanged.InvokeAsync(new DirectoryTreeExpansionChange { Path = path, Expanded = false });
    }

    /// <summary>
    /// Inoltra la selezione del nodo come navigazione semantica
    /// </summary>
    /// <param name="args">Nodo selezionato</param>
    private async Task HandleChangeAsync(TreeEventArgs args)
    {
        string path = args.Value as string ?? "";
        // Radzen notifica Change anche quando Selected viene proiettato dai parametri
        if (!string.IsNullOrEmpty(path) && !string.Equals(path, this._currentPath, this.GetPathComparison()))
            await this.OnDirectorySelected.InvokeAsync(path);
    }

    /// <summary>
    /// Renderizza soltanto i nodi materializzati con Value stringa e chiave fullpath
    /// </summary>
    /// <param name="nodes">Nodi del livello</param>
    /// <returns>Componenti ufficiali Radzen del livello</returns>
    private RenderFragment RenderNodes(List<DirectoryTreeItem> nodes)
    {
        return builder =>
        {
            foreach (DirectoryTreeItem node in nodes)
            {
                builder.OpenComponent<RadzenTreeItem>(0);
                builder.SetKey(node.FullPath);
                builder.AddAttribute(1, nameof(RadzenTreeItem.Text), node.Name);
                builder.AddAttribute(2, nameof(RadzenTreeItem.Value), node.FullPath);
                builder.AddAttribute(3, nameof(RadzenTreeItem.HasChildren), node.IsDirectory);
                builder.AddAttribute(4, nameof(RadzenTreeItem.Expanded), this._expandedPaths.Contains(node.FullPath));
                builder.AddAttribute(5, nameof(RadzenTreeItem.Selected), ReferenceEquals(node, this._selectedNode));
                builder.AddAttribute(6, nameof(RadzenTreeItem.Template), this.DirectoryTemplate);
                if (node.Children != null && node.Children.Count > 0)
                    builder.AddAttribute(7, nameof(RadzenTreeItem.ChildContent), this.RenderNodes(node.Children));
                builder.CloseComponent();
            }
        };
    }

    /// <summary>
    /// Materializza gli antenati dalla radice filesystem, senza consultare i mount
    /// </summary>
    private void RevealCurrentPath()
    {
        this._selectedNode = null;
        if (string.IsNullOrEmpty(this._currentPath))
            return;

        List<string> descendants = new List<string>();
        string rootPath = this.NormalizePath(Path.GetPathRoot(this._currentPath));
        DirectoryTreeItem node = this._roots.FirstOrDefault(root => string.Equals(root.FullPath, rootPath, this.GetPathComparison()));
        if (node == null)
            return;

        // La radice Unix mostra le sue cartelle anche quando CurrentPath coincide con /
        if (!OperatingSystem.IsWindows() && this._expandedPaths.Add(node.FullPath))
            this._pendingExpansions.Add(node.FullPath);
        DirectoryInfo directory = new DirectoryInfo(this._currentPath);
        while (directory != null)
        {
            string path = this.NormalizePath(directory.FullName);
            if (string.Equals(path, rootPath, this.GetPathComparison()))
                break;
            descendants.Add(path);
            directory = directory.Parent;
        }
        descendants.Reverse();
        foreach (string path in descendants)
        {
            if (node == null)
                break;
            this.LoadChildren(node);
            if (this._expandedPaths.Add(node.FullPath))
                this._pendingExpansions.Add(node.FullPath);
            DirectoryTreeItem next = node.Children.FirstOrDefault(child => string.Equals(child.FullPath, path, this.GetPathComparison()));
            if (next == null)
            {
                // Una cartella appena creata può non essere ancora nella cache del padre
                this.LoadChildren(node, true);
                next = node.Children.FirstOrDefault(child => string.Equals(child.FullPath, path, this.GetPathComparison()));
            }
            node = next;
        }
        this._selectedNode = node;
    }

    /// <summary>
    /// Allinea i figli del nodo corrente all'elenco già caricato dal pannello, senza letture filesystem aggiuntive
    /// </summary>
    private void RefreshCurrentChildren()
    {
        if (this.Entries == null || string.IsNullOrEmpty(this._currentPath))
            return;
        DirectoryTreeItem node = this.FindNode(this._roots, this._currentPath);
        if (node == null)
            return;
        if (this.Entries.Count == 0)
        {
            // Elenco vuoto ambiguo (directory vuota o non ancora caricata): rilegge solo un ramo che mostrava figli
            if (node.Children != null && node.Children.Count > 0)
                this.LoadChildren(node, true);
            return;
        }
        // L'elenco deve appartenere alla directory corrente, non a quella appena lasciata
        string parent = this.NormalizePath(Path.GetDirectoryName(this.Entries[0].FullPath));
        if (!string.Equals(parent, this._currentPath, this.GetPathComparison()))
            return;
        // Stesso ordinamento di IFileSystemService.GetSubDirectories, indipendente dal sort del pannello
        this.ProjectChildren(node, this.Entries.Where(entry => entry.IsDirectory).OrderBy(entry => entry.Name, StringComparer.OrdinalIgnoreCase));
    }

    /// <summary>
    /// Carica o aggiorna un solo livello, conservando i nodi e i rami ancora presenti
    /// </summary>
    /// <param name="node">Nodo da materializzare</param>
    /// <param name="reload">True per rileggere anche un livello già materializzato</param>
    private void LoadChildren(DirectoryTreeItem node, bool reload = false)
    {
        if (node.Children != null && !reload)
            return;
        this.ProjectChildren(node, this.FileSystemService.GetSubDirectories(node.FullPath));
    }

    /// <summary>
    /// Sostituisce i figli di un nodo conservando le istanze, e quindi i rami, ancora presenti
    /// </summary>
    /// <param name="node">Nodo da aggiornare</param>
    /// <param name="directories">Sottodirectory già ordinate</param>
    private void ProjectChildren(DirectoryTreeItem node, IEnumerable<FileSystemEntry> directories)
    {
        StringComparer comparer = this.GetPathComparison() == StringComparison.Ordinal ? StringComparer.Ordinal : StringComparer.OrdinalIgnoreCase;
        Dictionary<string, DirectoryTreeItem> previous = node.Children == null ? new Dictionary<string, DirectoryTreeItem>(comparer) : node.Children.ToDictionary(child => child.FullPath, comparer);
        List<DirectoryTreeItem> children = new List<DirectoryTreeItem>();
        foreach (FileSystemEntry entry in directories)
        {
            string path = this.NormalizePath(entry.FullPath);
            if (previous.TryGetValue(path, out DirectoryTreeItem child))
                children.Add(child);
            else
                children.Add(new DirectoryTreeItem(entry));
        }
        node.Children = children;
    }

    /// <summary>
    /// Ripristina solo i rami richiesti dallo snapshot, senza una scansione del filesystem
    /// </summary>
    /// <param name="nodes">Livello già materializzato</param>
    private void LoadExpandedBranches(List<DirectoryTreeItem> nodes)
    {
        foreach (DirectoryTreeItem node in nodes)
        {
            if (this._expandedPaths.Contains(node.FullPath))
            {
                this.LoadChildren(node);
                this.LoadExpandedBranches(node.Children);
            }
        }
    }

    /// <summary>
    /// Cerca soltanto nella cache UI, senza effettuare letture filesystem
    /// </summary>
    /// <param name="nodes">Livello della cache</param>
    /// <param name="path">Identità richiesta</param>
    /// <returns>Nodo trovato oppure null</returns>
    private DirectoryTreeItem FindNode(List<DirectoryTreeItem> nodes, string path)
    {
        foreach (DirectoryTreeItem node in nodes)
        {
            if (string.Equals(node.FullPath, path, this.GetPathComparison()))
                return node;
            DirectoryTreeItem match = node.Children == null ? null : this.FindNode(node.Children, path);
            if (match != null)
                return match;
        }
        return null;
    }

    /// <summary>
    /// Restituisce il confronto percorso della piattaforma
    /// </summary>
    /// <returns>Confronto case-aware del filesystem</returns>
    private StringComparison GetPathComparison()
    {
        return OperatingSystem.IsWindows() || OperatingSystem.IsMacOS() ? StringComparison.OrdinalIgnoreCase : StringComparison.Ordinal;
    }

    /// <summary>
    /// Normalizza separatori finali senza trasformare la radice in un percorso vuoto
    /// </summary>
    /// <param name="path">Percorso semantico</param>
    /// <returns>Percorso completo normalizzato</returns>
    private string NormalizePath(string path)
    {
        return string.IsNullOrEmpty(path) ? "" : Path.TrimEndingDirectorySeparator(Path.GetFullPath(path));
    }

    /// <summary>
    /// Rilascia il modulo di scroll, che non registra listener o observer
    /// </summary>
    public async ValueTask DisposeAsync()
    {
        if (this._isDisposed)
            return;
        this._isDisposed = true;
        try
        {
            IJSObjectReference module = this._jsModule;
            if (module == null && this._moduleImport != null)
                module = await this._moduleImport;
            if (module != null)
                await module.DisposeAsync();
        }
        catch (Exception ex) when (ex is JSDisconnectedException || ex is OperationCanceledException)
        {
        }
    }

    /// <summary>
    /// Adatta un'entry filesystem al valore semantico richiesto dal tree Radzen
    /// </summary>
    private sealed class DirectoryTreeItem
    {
        /// <summary>
        /// Crea un nodo lazy dal modello filesystem esistente
        /// </summary>
        /// <param name="entry">Directory sorgente</param>
        public DirectoryTreeItem(FileSystemEntry entry)
        {
            this.Name = entry.Name;
            this.FullPath = Path.TrimEndingDirectorySeparator(Path.GetFullPath(entry.FullPath));
            this.IsDirectory = entry.IsDirectory;
        }

        /// <summary>
        /// Nome visualizzato
        /// </summary>
        public string Name { get; }

        /// <summary>
        /// Percorso completo usato come identità semantica
        /// </summary>
        public string FullPath { get; }

        /// <summary>
        /// Indica se il nodo può essere espanso
        /// </summary>
        public bool IsDirectory { get; }

        /// <summary>
        /// Figli materializzati nella cache UI, null fino alla prima espansione
        /// </summary>
        public List<DirectoryTreeItem> Children { get; set; }
    }
}
