@namespace Bivium.Components.Pages
@page "/"
@inject IJSRuntime JSRuntime
@inject NotificationService NotificationService

<PageTitle>Bivium File Manager</PageTitle>

@if (!this._authReady)
{
    <RadzenCard class="bivium-page-state"><RadzenText TextStyle="TextStyle.Body1" Text="Loading Bivium…" /><RadzenProgressBar Mode="ProgressBarMode.Indeterminate" ShowValue="false" /></RadzenCard>
}
else if (!this._canAccess)
{
    <Bivium.Components.Shared.LoginDialog RequiresTwoFactor="@this._authStatus.TwoFactorEnabled" OnLogin="this.HandleLoginComplete" />
}
else if (!this._presenceInitialized)
{
    <RadzenCard class="bivium-page-state"><RadzenText TextStyle="TextStyle.Body1" Text="Connecting workspace…" /><RadzenProgressBar Mode="ProgressBarMode.Indeterminate" ShowValue="false" /></RadzenCard>
}
else if (!this._clientAttached || !this._hasActiveLease)
{
    <div class="workspace-takeover-overlay">
        <RadzenCard class="workspace-takeover-card">
            <RadzenStack Gap="1rem">
                <RadzenText TextStyle="TextStyle.Body1" Text="@("Bivium is already open from IP " + (this._observedLease?.RemoteIp ?? "unknown") + ". Make this session active?")" />
                @if (this._observedLease != null && !string.IsNullOrEmpty(this._observedLease.ClientLabel))
                {
                    <RadzenText TextStyle="TextStyle.Body2" class="workspace-takeover-client" Text="@this._observedLease.ClientLabel" />
                }
                <RadzenButton Text="Make this session active" Icon="switch_account" ButtonStyle="ButtonStyle.Primary" IsBusy="@this._takeoverInProgress" Disabled="@this._takeoverInProgress" Click="this.RequestWorkspaceTakeover" />
            </RadzenStack>
        </RadzenCard>
    </div>
}
else
{
    System.Collections.Generic.IReadOnlyList<Bivium.Components.Shared.CommanderCommandState> commands = this.GetCommandStates();
<CascadingValue Value="@(new WorkspaceSurfaceOwner(this._attachmentId, this._leaseGeneration, this._workspaceWorkflow?.Id ?? Guid.Empty, this._workspaceWorkflow?.QuestionId ?? Guid.Empty, this._workspaceWorkflow?.Phase ?? WorkspaceWorkflowPhase.Dismissed, this._workspaceUpload?.Id ?? Guid.Empty))">
<div id="workspace-desktop" style="height:100%" aria-busy="@(this._handoffDrainId != Guid.Empty ? "true" : "false")">
<RadzenLayout class="commander-layout">
    <RadzenHeader>
    <div class="bivium-header-bar">
    <Bivium.Components.Shared.MenuBar
        Commands="@commands"
        OnNewFile="this.DoNewFile" OnNewFolder="this.DoNewFolder" OnDownload="this.DoDownload" OnUpload="this.DoUpload"
        OnResetWorkspace="this.DoResetWorkspace" OnCopy="this.DoCopy" OnCut="this.DoCut" OnPaste="this.DoPaste"
        OnDelete="this.DoDelete" OnRename="this.DoRename" OnSelectAll="this.DoSelectAll" OnAdvancedRename="this.DoAdvancedRename"
        OnRefresh="this.DoRefresh" OnTerminal="this.DoToggleTerminalAsync" OnEditorExtensions="this.DoEditorExtensions"
        TerminalVisible="@this.IsTerminalVisible()" TerminalMinimized="@this.IsTerminalMinimized()"
        TerminalNeedsAttention="@(this._terminalPanel != null && this._terminalPanel.NeedsAttention())"
        OnCreationPermissions="this.DoCreationPermissions" OnAuthenticationSettings="this.DoAuthenticationSettings"
        OnExtract="this.DoExtract" OnCompress="this.DoCompress" OnToggleSinglePanel="this.DoToggleSinglePanel"
        ThemeOptions="@RadzenThemeCatalog.GetThemes()" CurrentTheme="@this._currentTheme" OnThemeChanged="this.DoThemeChange"
        OnLogout="this.DoLogout" SinglePanelMode="@this._singlePanelMode" IsMultiSelection="@(this.GetActivePanel().SelectedPaths.Count > 1)"
        CanLogout="@this._authStatus.Authenticated"
        CanManageAuthenticationSettings="@this._authStatus.CanManageSettings" CanInvoke="this.CanMutateWorkspace"
        OnAbout="this.DoAbout" />
    @if (this._compactLayout && !this._singlePanelMode)
    {
        <RadzenButton class="bivium-panel-switch" Text="@(this._activePanel == 0 ? "Left" : "Right")" Icon="swap_horiz"
                      ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Size="ButtonSize.Small"
                      title="@(this._activePanel == 0 ? "Show right panel" : "Show left panel")"
                      aria-label="@(this._activePanel == 0 ? "Show right panel" : "Show left panel")" Click="this.SwitchResponsivePanel" />
    }
    </div>
    </RadzenHeader>
    <RadzenBody>
    <RadzenMediaQuery Query="(max-width: 768px)" Change="this.HandleCompactLayoutChanged" />
    <div class="radzen-panels-area">
        <div id="outer-splitter-host" class="radzen-outer-splitter-host">
            @if (!this._singlePanelMode && this._compactLayout && this._activePanel == 1)
            {
                @* Narrow viewport: a single panel, the active one; the switch is in the header *@
                <Bivium.Components.Panel.FilePanel @key="@("right")" State="@this._rightPanel" IsActive="true" PanelId="right" AttachmentId="@this._attachmentId" LeaseGeneration="@this._leaseGeneration"
                    OnNavigate="this.HandleRightNavigate" OnSortChanged="this.HandleRightSortChanged" OnScrollAnchorChanged="this.HandleRightScrollAnchorChanged"
                    OnPageSizeChanged="this.HandleRightPageSizeChanged" OnTreeExpansionChanged="this.HandleRightTreeExpansionChanged"
                    OnTreeLayoutChanged="this.HandleRightTreeLayoutChanged" OnStateChanged="this.HandlePanelUiStateChanged"
                    OnActivated="() => this.SetActivePanel(1)" OnContextMenu="args => this.HandleContextMenuRequest(args, 1)" />
            }
            else if (this._singlePanelMode || this._compactLayout)
            {
                <Bivium.Components.Panel.FilePanel @key="@("left")" State="@this._leftPanel" IsActive="true" PanelId="left" AttachmentId="@this._attachmentId" LeaseGeneration="@this._leaseGeneration"
                    OnNavigate="this.HandleLeftNavigate" OnSortChanged="this.HandleLeftSortChanged" OnScrollAnchorChanged="this.HandleLeftScrollAnchorChanged"
                    OnPageSizeChanged="this.HandleLeftPageSizeChanged" OnTreeExpansionChanged="this.HandleLeftTreeExpansionChanged"
                    OnTreeLayoutChanged="this.HandleLeftTreeLayoutChanged" OnStateChanged="this.HandlePanelUiStateChanged"
                    OnActivated="() => this.SetActivePanel(0)" OnContextMenu="args => this.HandleContextMenuRequest(args, 0)" />
            }
            else
            {
                <RadzenSplitter Orientation="Orientation.Horizontal" Style="height:100%" Resize="this.HandleOuterSplitterResize" Collapse="this.HandleOuterSplitterCollapse" Expand="this.HandleOuterSplitterExpand">
                    <RadzenSplitterPane Size="@(this._outerPanelSizePercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "%")"
                                        Min="20%" Max="80%" Collapsible="true" Collapsed="@(this._collapsedPanelIndex == 0)"
                                        ResizeAriaLabel="Resize file panels" CollapseAriaLabel="Collapse left panel" ExpandAriaLabel="Expand left panel">
                        <Bivium.Components.Panel.FilePanel @key="@("left")" State="@this._leftPanel" IsActive="@(this._activePanel == 0)" PanelId="left" AttachmentId="@this._attachmentId" LeaseGeneration="@this._leaseGeneration"
                            OnNavigate="this.HandleLeftNavigate" OnSortChanged="this.HandleLeftSortChanged" OnScrollAnchorChanged="this.HandleLeftScrollAnchorChanged"
                            OnPageSizeChanged="this.HandleLeftPageSizeChanged" OnTreeExpansionChanged="this.HandleLeftTreeExpansionChanged"
                            OnTreeLayoutChanged="this.HandleLeftTreeLayoutChanged" OnStateChanged="this.HandlePanelUiStateChanged"
                            OnActivated="() => this.SetActivePanel(0)" OnContextMenu="args => this.HandleContextMenuRequest(args, 0)" />
                    </RadzenSplitterPane>
                    <RadzenSplitterPane Min="20%" Collapsible="true" Collapsed="@(this._collapsedPanelIndex == 1)"
                                        CollapseAriaLabel="Collapse right panel" ExpandAriaLabel="Expand right panel">
                        <Bivium.Components.Panel.FilePanel @key="@("right")" State="@this._rightPanel" IsActive="@(this._activePanel == 1)" PanelId="right" AttachmentId="@this._attachmentId" LeaseGeneration="@this._leaseGeneration"
                            OnNavigate="this.HandleRightNavigate" OnSortChanged="this.HandleRightSortChanged" OnScrollAnchorChanged="this.HandleRightScrollAnchorChanged"
                            OnPageSizeChanged="this.HandleRightPageSizeChanged" OnTreeExpansionChanged="this.HandleRightTreeExpansionChanged"
                            OnTreeLayoutChanged="this.HandleRightTreeLayoutChanged" OnStateChanged="this.HandlePanelUiStateChanged"
                            OnActivated="() => this.SetActivePanel(1)" OnContextMenu="args => this.HandleContextMenuRequest(args, 1)" />
                    </RadzenSplitterPane>
                </RadzenSplitter>
            }
        </div>
    </div>

    </RadzenBody>
    <RadzenFooter>
    <Bivium.Components.Shared.StatusBar SelectedPaths="@this.GetActivePanel().SelectedPaths" CurrentPath="@this.GetActivePanel().CurrentPath"
        Windows="@this.GetOpenWindows()" CanActivateWindows="@this.CanActivateWindows()" OnWindowActivate="this.RestoreWindowAsync"
        Entries="@this.GetActivePanel().Entries" ProgressText="@this.GetStatusCenterText()" CanCancelOperation="@(this._desktopWorkspace?.Operation?.IsRunning == true)"
        OnCancelOperation="this.CancelActiveOperation" />

    </RadzenFooter>
</RadzenLayout>

@if (this._contextMenuVisible)
{
<Bivium.Components.Shared.ContextMenu @key="(this._contextDraft?.Id, this._leaseGeneration)" Draft="this._contextDraft" PublishVisual="this.PublishContextVisual" Commands="@commands" X="@this._contextMenuX" Y="@this._contextMenuY"
    OnClose="this.CloseContextMenu" OnOpen="this.DoOpen" OnEdit="this.DoEdit" OnCut="this.DoCut" OnCopy="this.DoCopy"
    OnPaste="this.DoPaste" OnRename="this.DoRename" OnDelete="this.DoDelete" OnNewFile="this.DoNewFile" OnNewFolder="this.DoNewFolder"
    OnDownload="this.DoDownload" OnUpload="this.DoUpload" OnExtract="this.DoExtract" OnExtractToFolder="this.DoExtractToFolder"
    OnCompress="this.DoCompress" OnRefresh="this.DoRefresh" OnAdvancedRename="this.DoAdvancedRename" OnPermissions="this.DoPermissions"
    OnProperties="this.DoProperties" IsDirectory="@this._contextMenuIsDirectory" IsArchive="@this._contextMenuIsArchive"
    ArchiveBaseName="@this._contextMenuArchiveBaseName" HasSelection="@this._contextMenuHasSelection"
    IsMultiSelection="@this._contextMenuIsMultiSelection" IsEditable="@this._contextMenuIsEditable" CanInvoke="this.CanInvokeCapturedContext" />
}

<Bivium.Components.Shared.ConfirmDialog @key="(typeof(ConfirmDialog), this._workspaceWorkflow?.Kind is WorkspaceWorkflowKind.DeleteEntries or WorkspaceWorkflowKind.EditorAlert or WorkspaceWorkflowKind.ResetWorkspace ? this._workspaceWorkflow.Id : Guid.Empty)" @ref="this._confirmDialog" Workflow="@(this._workspaceWorkflow?.Kind is WorkspaceWorkflowKind.DeleteEntries or WorkspaceWorkflowKind.EditorAlert or WorkspaceWorkflowKind.ResetWorkspace ? this._workspaceWorkflow : null)" AttachmentId="@this._attachmentId" LeaseGeneration="@this._leaseGeneration" OnResetConfirmed="this.HandleWorkspaceResetConfirmed" />
<Bivium.Components.Shared.EditorCloseDialog @key="(typeof(EditorCloseDialog), this._workspaceWorkflow?.Kind == WorkspaceWorkflowKind.EditorClose ? this._workspaceWorkflow.Id : Guid.Empty)" @ref="this._editorCloseDialog" Workflow="@(this._workspaceWorkflow?.Kind == WorkspaceWorkflowKind.EditorClose ? this._workspaceWorkflow : null)" AttachmentId="@this._attachmentId" LeaseGeneration="@this._leaseGeneration" OnResolved="this.HandleEditorCloseResolved" />
<Bivium.Components.Shared.OverwriteDialog @key="(typeof(OverwriteDialog), this._workspaceWorkflow?.Kind is WorkspaceWorkflowKind.CopyEntries or WorkspaceWorkflowKind.MoveEntries or WorkspaceWorkflowKind.TransferEntries ? this._workspaceWorkflow.Id : Guid.Empty)" @ref="this._overwriteDialog" Workflow="@(this._workspaceWorkflow?.Kind is WorkspaceWorkflowKind.CopyEntries or WorkspaceWorkflowKind.MoveEntries or WorkspaceWorkflowKind.TransferEntries ? this._workspaceWorkflow : null)" AttachmentId="@this._attachmentId" LeaseGeneration="@this._leaseGeneration" />
<Bivium.Components.Shared.InputDialog @key="(typeof(InputDialog), this._workspaceWorkflow?.Id ?? Guid.Empty)" @ref="this._inputDialog" Workflow="@this._workspaceWorkflow" AttachmentId="@this._attachmentId" LeaseGeneration="@this._leaseGeneration" />
<Bivium.Components.Shared.PropertiesDialog @key="(typeof(PropertiesDialog), this._workspaceWorkflow?.Id, this._leaseGeneration)" @ref="this._propertiesDialog" Workflow="@(this._workspaceWorkflow?.Kind == WorkspaceWorkflowKind.Properties ? this._workspaceWorkflow : null)" Operation="@this._desktopWorkspace?.Operation" AttachmentId="@this._attachmentId" LeaseGeneration="@this._leaseGeneration" />
<Bivium.Components.Shared.PermissionsDialog @key="(typeof(PermissionsDialog), this._workspaceWorkflow?.Id, this._leaseGeneration)" @ref="this._permissionsDialog" Workflow="@(this._workspaceWorkflow?.Kind == WorkspaceWorkflowKind.Permissions ? this._workspaceWorkflow : null)" AttachmentId="@this._attachmentId" LeaseGeneration="@this._leaseGeneration" />
<Bivium.Components.Shared.AboutDialog @key="(typeof(AboutDialog), this._workspaceWorkflow?.Id, this._leaseGeneration)" @ref="this._aboutDialog" Workflow="@(this._workspaceWorkflow?.Kind == WorkspaceWorkflowKind.About ? this._workspaceWorkflow : null)" AttachmentId="@this._attachmentId" LeaseGeneration="@this._leaseGeneration" />
<Bivium.Components.Shared.UploadDialog @key="(typeof(UploadDialog), this._workspaceUpload?.Id, this._leaseGeneration)" @ref="this._uploadDialog" Upload="@this._workspaceUpload" AttachmentId="@this._attachmentId" LeaseGeneration="@this._leaseGeneration" />
<Bivium.Components.Shared.CompressDialog @key="(typeof(CompressDialog), this._workspaceWorkflow?.Id, this._leaseGeneration)" @ref="this._compressDialog" Workflow="@(this._workspaceWorkflow?.Kind == WorkspaceWorkflowKind.Compress ? this._workspaceWorkflow : null)" AttachmentId="@this._attachmentId" LeaseGeneration="@this._leaseGeneration" CanInvoke="this.CanMutateWorkspace" />
<Bivium.Components.Shared.SettingsDialog @key="(typeof(SettingsDialog), this._workspaceWorkflow?.Id, this._leaseGeneration)" @ref="this._settingsDialog" Workflow="@(this._workspaceWorkflow?.Kind == WorkspaceWorkflowKind.EditorExtensions ? this._workspaceWorkflow : null)" AttachmentId="@this._attachmentId" LeaseGeneration="@this._leaseGeneration" />
<Bivium.Components.Shared.CreationPermissionsDialog @key="(typeof(CreationPermissionsDialog), this._workspaceWorkflow?.Id, this._leaseGeneration)" @ref="this._creationPermissionsDialog" Workflow="@(this._workspaceWorkflow?.Kind == WorkspaceWorkflowKind.CreationPermissions ? this._workspaceWorkflow : null)" AttachmentId="@this._attachmentId" LeaseGeneration="@this._leaseGeneration" />
<Bivium.Components.Shared.AuthSettingsDialog @ref="this._authSettingsDialog" Workflow="@(this._workspaceWorkflow?.Kind == WorkspaceWorkflowKind.Authentication ? this._workspaceWorkflow : null)" AttachmentId="@this._attachmentId" LeaseGeneration="@this._leaseGeneration" OnClose="this.HandleSettingsDialogClose" CanInvoke="this.CanMutateWorkspace" />
<Bivium.Components.Shared.WorkspaceFormFailureDialog @key="(typeof(WorkspaceFormFailureDialog), this._workspaceWorkflow?.Id, this._leaseGeneration)" @ref="this._formFailureDialog" Workflow="@this._workspaceWorkflow" AttachmentId="@this._attachmentId" LeaseGeneration="@this._leaseGeneration" />
<Bivium.Components.Shared.WorkspaceTerminalDialog @key="(typeof(WorkspaceTerminalDialog), this._workspaceWorkflow?.Id, this._leaseGeneration)" @ref="this._terminalWorkflowDialog" Workflow="@(this._workspaceWorkflow?.Kind is WorkspaceWorkflowKind.TerminalRename or WorkspaceWorkflowKind.TerminalClose or WorkspaceWorkflowKind.TerminalClipboard ? this._workspaceWorkflow : null)" AttachmentId="@this._attachmentId" LeaseGeneration="@this._leaseGeneration" />
<Bivium.Components.Shared.EditorDialog @ref="this._editorDialog" AttachmentId="@this._attachmentId" LeaseGeneration="@this._leaseGeneration" IsActive="@(this.GetActiveDesktopWindowId() == "editor-window")" OnClose="this.HandleEditorDialogClose" OnStateChanged="this.HandleDesktopWindowStateChanged" />
<Bivium.Components.Shared.RenamerDialog @ref="this._renamerDialog" AttachmentId="@this._attachmentId" LeaseGeneration="@this._leaseGeneration" Workflow="@(this._workspaceWorkflow?.Kind == WorkspaceWorkflowKind.BatchRename ? this._workspaceWorkflow : null)" Operation="@this._desktopWorkspace?.Operation" IsActive="@(this.GetActiveDesktopWindowId() == "renamer-window")" OnClose="this.HandleRenamerDialogClose" OnStateChanged="this.HandleDesktopWindowStateChanged" />
<Bivium.Components.Shared.TerminalPanel @ref="this._terminalPanel" WorkingDirectory="@this.GetActivePanel().CurrentPath" AttachmentId="@this._attachmentId"
    LeaseGeneration="@this._leaseGeneration" CanInvoke="this.CanMutateWorkspace" IsActive="@(this.GetActiveDesktopWindowId() == "terminal-window")" OnClose="this.HandleTerminalClose" OnStateChanged="this.HandleDesktopWindowStateChanged" />
</div>
</CascadingValue>
@if (this._handoffDrainId != Guid.Empty)
{
    <div class="workspace-takeover-overlay" role="status" aria-live="polite" style="position:fixed;inset:0;z-index:10000;background:var(--rz-body-background-color)">
        <RadzenCard class="workspace-takeover-card"><RadzenText Text="Transferring the desktop…" /><RadzenProgressBar Mode="ProgressBarMode.Indeterminate" ShowValue="false" /></RadzenCard>
    </div>
}
}
