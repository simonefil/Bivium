<table id="@this.TableId" class="file-list-table @(this.HasValidColumnRatios() ? "custom-columns" : "")">
    <colgroup>
        <col style="@this.GetColumnStyle(this.NameColumnRatio)" />
        <col style="@this.GetColumnStyle(this.SizeColumnRatio)" />
        <col style="@this.GetColumnStyle(this.DateColumnRatio)" />
        <col style="@this.GetColumnStyle(this.AttributesColumnRatio)" />
        <col style="@this.GetColumnStyle(this.OwnerColumnRatio)" />
    </colgroup>
    <thead>
        <tr>
            <th @onclick="() => this.ToggleSort(SortField.Name)">
                Name @this.GetSortIndicator(SortField.Name)
                <span class="column-resize-handle" data-column-resizer="0" title="Resize columns"></span>
            </th>
            <th @onclick="() => this.ToggleSort(SortField.Size)">
                Size @this.GetSortIndicator(SortField.Size)
                <span class="column-resize-handle" data-column-resizer="1" title="Resize columns"></span>
            </th>
            <th @onclick="() => this.ToggleSort(SortField.Date)">
                Date @this.GetSortIndicator(SortField.Date)
                <span class="column-resize-handle" data-column-resizer="2" title="Resize columns"></span>
            </th>
            <th @onclick="() => this.ToggleSort(SortField.Attributes)">
                Attr @this.GetSortIndicator(SortField.Attributes)
                <span class="column-resize-handle" data-column-resizer="3" title="Resize columns"></span>
            </th>
            <th @onclick="() => this.ToggleSort(SortField.Owner)">
                Owner @this.GetSortIndicator(SortField.Owner)
            </th>
        </tr>
    </thead>
    <tbody>
        @* Parent directory row *@
        @if (this._hasParent)
        {
            <tr class="entry-parent"
                @ondblclick="this.NavigateToParent">
                <td>[..] ..</td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
            </tr>
        }

        <Virtualize @key="this.Entries"
                    @ref="this._virtualizeComponent"
                    ItemsProvider="this.GetRows"
                    Context="row"
                    ItemSize="20"
                    OverscanCount="30"
                    SpacerElement="tr">
            @{
                int localIdx = row.Index;
                FileSystemEntry entry = row.Entry;
                bool isSelected = this._selectedPathSet.Contains(entry.FullPath);
                bool isCursor = localIdx == this.CursorIndex;
            }

            <tr class="@(isSelected ? "selected" : "") @(isCursor ? "cursor" : "") @(entry.IsDirectory ? "entry-dir" : "entry-file")"
                data-entry-path="@entry.FullPath"
                @onclick="(e) => this.HandleRowClick(localIdx, e)"
                @ondblclick="() => this.HandleRowDoubleClick(localIdx)"
                @oncontextmenu="(e) => this.HandleRowContextMenu(localIdx, e)"
                @oncontextmenu:preventDefault="true"
                @oncontextmenu:stopPropagation="true">
                <td title="@entry.Name">@entry.Name@(entry.IsSymLink ? " @" : "")</td>
                <td>@entry.FormatSize()</td>
                <td>@entry.FormatDate()</td>
                <td>@entry.Attributes</td>
                <td>@entry.Owner</td>
            </tr>
        </Virtualize>

        @* Empty directory message *@
        @if (this.Entries.Count == 0)
        {
            <tr>
                <td colspan="5" style="color: var(--foreground2); text-align: center;">Empty directory</td>
            </tr>
        }
    </tbody>
</table>
