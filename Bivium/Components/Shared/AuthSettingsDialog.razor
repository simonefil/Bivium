@inject IJSRuntime JSRuntime

@if (this._isVisible)
{
    <div class="context-menu-overlay" @onclick="this.HandleCancel">
        <div class="context-menu" style="position: fixed; left: 50%; top: 50%; transform: translate(-50%, -50%); min-width: 52ch;"
             @onclick:stopPropagation="true">
            <div style="background-color: var(--background1); padding: 0 1ch; border-bottom: 1px solid var(--foreground2);">
                Authentication
            </div>
            <div style="padding: 1lh 1ch;">
                <table style="width: 100%;">
                    <tr>
                        <td style="width: 16ch; color: var(--foreground2);">Enabled:</td>
                        <td><input type="checkbox" @bind="this._enabled" /></td>
                    </tr>
                    <tr>
                        <td style="color: var(--foreground2);">Username:</td>
                        <td><input @bind="this._username" style="width: 100%; background-color: var(--background1); color: var(--foreground0); border: 1px solid var(--foreground2);" /></td>
                    </tr>
                    @if (this._hasUser)
                    {
                        <tr>
                            <td style="color: var(--foreground2);">Current password:</td>
                            <td><input type="password" @bind="this._currentPassword" style="width: 100%; background-color: var(--background1); color: var(--foreground0); border: 1px solid var(--foreground2);" /></td>
                        </tr>
                    }
                    <tr>
                        <td style="color: var(--foreground2);">@this._passwordLabel</td>
                        <td><input type="password" @bind="this._newPassword" style="width: 100%; background-color: var(--background1); color: var(--foreground0); border: 1px solid var(--foreground2);" /></td>
                    </tr>
                    @if (this._hasUser)
                    {
                        <tr>
                            <td style="color: var(--foreground2);">Disabled:</td>
                            <td>@this._disabledLabel</td>
                        </tr>
                        <tr>
                            <td style="color: var(--foreground2);">2FA:</td>
                            <td>@this._twoFactorLabel</td>
                        </tr>
                    }
                </table>

                @if (this._hasUser && !this._disabled)
                {
                    <div style="display: flex; gap: 2ch; margin-top: 1lh;">
                        @if (!this._twoFactorEnabled)
                        {
                            <button @onclick="this.HandleStartTwoFactorSetup">Setup 2FA</button>
                        }
                        @if (this._twoFactorEnabled)
                        {
                            <button @onclick="this.HandleDisableTwoFactor">Disable 2FA</button>
                        }
                    </div>
                }

                @if (!string.IsNullOrEmpty(this._qrCodeDataUrl))
                {
                    <div style="margin-top: 1lh;">
                        <div style="color: var(--foreground2); margin-bottom: 0.5lh;">Scan QR, enter current code, then enable.</div>
                        <img src="@this._qrCodeDataUrl" alt="2FA QR code" style="background: white; padding: 1ch; width: 160px; height: 160px;" />
                        <div style="margin-top: 0.5lh;">
                            <input @bind="this._twoFactorCode" style="width: 16ch; background-color: var(--background1); color: var(--foreground0); border: 1px solid var(--foreground2);" />
                            <button @onclick="this.HandleEnableTwoFactor">Enable 2FA</button>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(this._statusText))
                {
                    <div style="color: var(--foreground2); margin-top: 0.5lh;">
                        @this._statusText
                    </div>
                }
            </div>
            <div style="display: flex; justify-content: flex-end; gap: 2ch; padding: 0 1ch 1lh 1ch;">
                <button @onclick="this.HandleCancel">Cancel</button>
                <button @onclick="this.HandleSave">Save</button>
            </div>
        </div>
    </div>
}
