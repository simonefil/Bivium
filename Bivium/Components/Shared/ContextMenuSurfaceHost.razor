@namespace Bivium.Components.Shared

<div @ref="this._root" data-workspace-context-surface="true">@this.ChildContent</div>

@code {
    /// <summary>Official controls belonging to the context menu opening</summary>
    [Parameter] public RenderFragment ChildContent { get; set; }
    /// <summary>Notifies only the real mount of the Radzen portal</summary>
    [Parameter] public EventCallback<ElementReference> OnMounted { get; set; }
    /// <summary>Portal app root, not derived through DOM indexes</summary>
    private ElementReference _root;

    /// <summary>Content mount barrier, without polling or arbitrary delays</summary>
    /// <param name="firstRender">True on first mount</param>
    protected override System.Threading.Tasks.Task OnAfterRenderAsync(bool firstRender) => firstRender ? this.OnMounted.InvokeAsync(this._root) : System.Threading.Tasks.Task.CompletedTask;
}
