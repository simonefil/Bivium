@namespace Bivium.Components.Shared

@if (this._isVisible)
{
    <PersistentModalShell Surface="permissions" Label="@("Permissions - " + this._entryName)" CanClose="@(!this._binding.Rejected)" OnCancel="this.HandleCancel" OnContentRendered="this.HandleContentRenderedAsync">
        <div data-workspace-workflow-id="@this.Workflow.Id">
        <RadzenTemplateForm TItem="PermissionsDialog" Data="this" Submit="@(_ => this.HandleSave())">
        <RadzenStack class="bivium-radzen-modal" Gap="1rem" Style="width:100%;max-height:calc(100dvh - 9rem);box-sizing:border-box;">
                @if (this._model.IsUnix)
                {
                    <RadzenRow><RadzenColumn Size="12" SizeMD="6"><RadzenFormField Text="Owner" Component="permissions-owner" Style="width:100%;"><RadzenTextBox id="permissions-owner" Name="permissions-owner" @bind-Value="this._model.Owner" @bind-Value:after="this.PublishDraft" Immediate="true" Style="width:100%;" /></RadzenFormField></RadzenColumn><RadzenColumn Size="12" SizeMD="6"><RadzenFormField Text="Group" Component="permissions-group" Style="width:100%;"><RadzenTextBox id="permissions-group" Name="permissions-group" @bind-Value="this._model.Group" @bind-Value:after="this.PublishDraft" Immediate="true" Style="width:100%;" /></RadzenFormField></RadzenColumn></RadzenRow>
                    <RadzenTable class="bivium-radzen-permissions" aria-label="Unix permissions">
                        <RadzenTableHeader>
                            <RadzenTableHeaderRow><RadzenTableHeaderCell scope="col">Identity</RadzenTableHeaderCell><RadzenTableHeaderCell scope="col">Read</RadzenTableHeaderCell><RadzenTableHeaderCell scope="col">Write</RadzenTableHeaderCell><RadzenTableHeaderCell scope="col">Execute</RadzenTableHeaderCell></RadzenTableHeaderRow>
                        </RadzenTableHeader>
                        <RadzenTableBody>
                            <RadzenTableRow><RadzenTableHeaderCell scope="row">Owner</RadzenTableHeaderCell><RadzenTableCell><RadzenCheckBox @bind-Value="this._model.OwnerRead" @bind-Value:after="this.PublishDraft" AriaLabel="Owner read" /></RadzenTableCell><RadzenTableCell><RadzenCheckBox @bind-Value="this._model.OwnerWrite" @bind-Value:after="this.PublishDraft" AriaLabel="Owner write" /></RadzenTableCell><RadzenTableCell><RadzenCheckBox @bind-Value="this._model.OwnerExecute" @bind-Value:after="this.PublishDraft" AriaLabel="Owner execute" /></RadzenTableCell></RadzenTableRow>
                            <RadzenTableRow><RadzenTableHeaderCell scope="row">Group</RadzenTableHeaderCell><RadzenTableCell><RadzenCheckBox @bind-Value="this._model.GroupRead" @bind-Value:after="this.PublishDraft" AriaLabel="Group read" /></RadzenTableCell><RadzenTableCell><RadzenCheckBox @bind-Value="this._model.GroupWrite" @bind-Value:after="this.PublishDraft" AriaLabel="Group write" /></RadzenTableCell><RadzenTableCell><RadzenCheckBox @bind-Value="this._model.GroupExecute" @bind-Value:after="this.PublishDraft" AriaLabel="Group execute" /></RadzenTableCell></RadzenTableRow>
                            <RadzenTableRow><RadzenTableHeaderCell scope="row">Others</RadzenTableHeaderCell><RadzenTableCell><RadzenCheckBox @bind-Value="this._model.OthersRead" @bind-Value:after="this.PublishDraft" AriaLabel="Others read" /></RadzenTableCell><RadzenTableCell><RadzenCheckBox @bind-Value="this._model.OthersWrite" @bind-Value:after="this.PublishDraft" AriaLabel="Others write" /></RadzenTableCell><RadzenTableCell><RadzenCheckBox @bind-Value="this._model.OthersExecute" @bind-Value:after="this.PublishDraft" AriaLabel="Others execute" /></RadzenTableCell></RadzenTableRow>
                        </RadzenTableBody>
                    </RadzenTable>
                    <RadzenText TextStyle="TextStyle.Body1" Text="@("Octal: " + this.GetOctalString())" />
                }
                else
                {
                    <RadzenText TextStyle="TextStyle.Body1" Text="@("Owner: " + this._model.Owner)" />
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"><RadzenCheckBox Name="permissions-readonly" AriaLabel="Read-only" @bind-Value="this._model.WinReadOnly" @bind-Value:after="this.PublishDraft" /><RadzenLabel Component="permissions-readonly" Text="Read-only" /></RadzenStack>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"><RadzenCheckBox Name="permissions-hidden" AriaLabel="Hidden" @bind-Value="this._model.WinHidden" @bind-Value:after="this.PublishDraft" /><RadzenLabel Component="permissions-hidden" Text="Hidden" /></RadzenStack>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"><RadzenCheckBox Name="permissions-system" AriaLabel="System" @bind-Value="this._model.WinSystem" @bind-Value:after="this.PublishDraft" /><RadzenLabel Component="permissions-system" Text="System" /></RadzenStack>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"><RadzenCheckBox Name="permissions-archive" AriaLabel="Archive" @bind-Value="this._model.WinArchive" @bind-Value:after="this.PublishDraft" /><RadzenLabel Component="permissions-archive" Text="Archive" /></RadzenStack>
                }
                @if (this._isDirectory)
                {
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem"><RadzenCheckBox Name="permissions-recursive" AriaLabel="Apply recursively" @bind-Value="this._recursive" @bind-Value:after="this.PublishDraft" /><RadzenLabel Component="permissions-recursive" Text="Apply recursively" /></RadzenStack>
                }
                @if (!string.IsNullOrEmpty(this._errorMessage))
                {
                    <RadzenAlert AlertStyle="AlertStyle.Danger">@this._errorMessage</RadzenAlert>
                }
                @if (!string.IsNullOrEmpty(this._binding.Error))
                {
                    <RadzenAlert AlertStyle="AlertStyle.Warning">@this._binding.Error</RadzenAlert>
                }
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" AlignItems="AlignItems.Center" Gap="0.75rem"><RadzenButton @ref="this._cancelButton" Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="this.HandleCancel" /><RadzenButton Text="Save" Icon="save" ButtonType="ButtonType.Submit" Disabled="@(!this._canSave || this._binding.Rejected)" ButtonStyle="ButtonStyle.Primary" /></RadzenStack>
        </RadzenStack>
        </RadzenTemplateForm>
        </div>
    </PersistentModalShell>
}
