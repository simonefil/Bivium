@namespace Bivium.Components.Shared
@inject IJSRuntime JSRuntime

@if (this._isVisible)
{
    <PersistentModalShell Surface="upload" Label="Upload Files and Folders" OnCancel="this.HandleCancel" CanClose="@(!this._isUploading)" OnContentRendered="this.HandleContentRenderedAsync">
        <RadzenStack data-workspace-workflow-id="@this._sessionId" class="bivium-radzen-upload-dialog" Gap="1rem" Style="width:100%;max-height:calc(100dvh - 9rem);box-sizing:border-box;">
                <RadzenText TextStyle="TextStyle.Body1" Style="overflow-wrap:anywhere;">Destination: @this._destinationDir</RadzenText>

                <input type="file" id="upload-files-input" multiple style="display:none" />
                <input type="file" id="upload-directories-input" webkitdirectory multiple style="display:none" />

                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
                    <RadzenButton id="upload-add-files-button" @ref="this._browseButton" Text="Add Files..." Icon="upload_file" ButtonStyle="ButtonStyle.Secondary" Disabled="@this._isUploading" />
                    <RadzenButton id="upload-add-folders-button" Text="Add Folders..." Icon="drive_folder_upload" ButtonStyle="ButtonStyle.Secondary" Disabled="@this._isUploading" />
                    <RadzenButton Text="Clear" Icon="clear" ButtonStyle="ButtonStyle.Light" Click="this.HandleClearSelection" Disabled="@(this._isUploading || !this._hasLocalSelection)" />
                </RadzenStack>

                <RadzenCard Variant="Variant.Outlined" id="upload-drop-zone" class="@("upload-drop-zone " + (this._isUploading ? "upload-drop-disabled" : ""))">
                    <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Div" class="rz-m-0" Text="Drop files and folders here" />
                    <RadzenAlert AlertStyle="AlertStyle.Info" AllowClose="false" class="@("bivium-radzen-upload-hint " + (this.IsDropHintPersistent() ? "upload-hint-visible" : ""))">@this.GetDropHint()</RadzenAlert>
                </RadzenCard>

                <RadzenText TextStyle="TextStyle.Body1" Text="@this.GetSelectionSummary()" />
                @if (this._phase != WorkspaceUploadPhase.Selecting)
                {
                    <RadzenProgressBar Value="@this._progress" ShowValue="true" Unit="%" />
                    @if (!string.IsNullOrEmpty(this._currentItem))
                    {
                        <RadzenText TextStyle="TextStyle.Body2" TagName="TagName.Div" class="upload-current-item rz-m-0">@this.GetProgressSummary() @this._currentItem</RadzenText>
                    }
                }
                @if (!string.IsNullOrEmpty(this._statusText))
                {
                    <RadzenAlert AlertStyle="@(this._statusText.StartsWith("Error:", StringComparison.Ordinal) ? AlertStyle.Danger : AlertStyle.Info)" AllowClose="false">@this._statusText</RadzenAlert>
                }
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="this.HandleCancel" IsBusy="@this._isCancelling" BusyText="Cancelling..." Disabled="@(this._isCancelling || this._isPausing)" />
                    @if (this._isUploading)
                    {
                        <RadzenButton data-ui-key="upload-pause" Text="Pause" Icon="pause" ButtonStyle="ButtonStyle.Secondary" Click="this.HandlePause" IsBusy="@this._isPausing" BusyText="Pausing..." Disabled="@(this._isPausing || this._isCancelling)" />
                    }
                    <RadzenButton data-ui-key="upload-start" Text="@this.GetStartLabel()" Icon="cloud_upload" ButtonStyle="ButtonStyle.Primary" Click="this.HandleUpload" Disabled="@(this._isUploading || this._isCancelling || this._isPausing || !this._bridgeReady || !this._hasLocalSelection)" />
                </RadzenStack>
        </RadzenStack>
    </PersistentModalShell>
}
