@namespace Bivium.Components.Shared

<div @ref="this.Element" data-workspace-surface="@this.Surface" style="display:contents">@this.ChildContent</div>

@code {
    #region Properties
    /// <summary>Fragment owned by the original form</summary>
    [Parameter] public RenderFragment ChildContent { get; set; }
    /// <summary>Notifies the real mount and subsequent renders</summary>
    [Parameter] public EventCallback<bool> OnContentRendered { get; set; }
    /// <summary>App identity of the bridge surface</summary>
    [Parameter] public string Surface { get; set; } = "";
    /// <summary>Real root, without lookup through DOM indexes</summary>
    public ElementReference Element { get; private set; }
    #endregion

    #region Class Variables
    /// <summary>Guard after the owner is released</summary>
    private bool _detached;

    /// <summary>Notifies only renders requested by the owner, not the render caused by the callback itself</summary>
    private bool _notifyAfterRender = true;
    #endregion

    #region Public Methods

    /// <summary>Updates the content without replacing the form instance</summary>
    /// <param name="content">Updated owner fragment</param>
    /// <param name="notify">Notifies the render except for the callback's automatic refresh</param>
    public void Refresh(RenderFragment content, bool notify)
    {
        if (this._detached)
            return;
        this.ChildContent = content;
        this._notifyAfterRender = notify;
        this.StateHasChanged();
    }

    /// <summary>Removes the callbacks and content of a released owner</summary>
    public void Detach()
    {
        this._detached = true;
        this.ChildContent = null;
        this.StateHasChanged();
    }
    #endregion

    #region Overrides

    /// <summary>Notifies the actually mounted DOM, without polling</summary>
    /// <param name="firstRender">True only on the first render of the bridge</param>
    protected override System.Threading.Tasks.Task OnAfterRenderAsync(bool firstRender)
    {
        if (this._detached || !this._notifyAfterRender)
            return System.Threading.Tasks.Task.CompletedTask;
        this._notifyAfterRender = false;
        return this.OnContentRendered.InvokeAsync(firstRender);
    }
    #endregion
}
