@namespace Bivium.Components.Shared
@inject IJSRuntime JSRuntime

@if (this._isVisible)
{
    <PersistentModalShell Label="Editor Extensions" OnCancel="this.HandleCancel" CanClose="@(!this._isSaving)" OnContentRendered="this.HandleContentRenderedAsync">
        <RadzenStack class="bivium-radzen-modal" Gap="1rem" Style="width:100%;max-height:calc(100dvh - 9rem);box-sizing:border-box;">
                <RadzenText TextStyle="TextStyle.Body1" Text="One extension per line, including the dot (e.g. .txt)" />
                <RadzenFormField Text="File extensions" Component="editor-extensions-textarea" Style="width:100%;">
                    <RadzenTextArea id="editor-extensions-textarea" Name="editor-extensions-textarea" @ref="this._textareaElement" @bind-Value="this._extensionsText" Immediate="true" Disabled="@this._isSaving" Rows="12" Style="width:100%;resize:vertical;" />
                </RadzenFormField>
                @if (!string.IsNullOrEmpty(this._statusText))
                {
                    <RadzenAlert AlertStyle="AlertStyle.Danger" Shade="Shade.Lighter">@this._statusText</RadzenAlert>
                }
                <div class="bivium-radzen-dialog-actions">
                    <RadzenButton Text="Cancel" Disabled="@this._isSaving" ButtonStyle="ButtonStyle.Light" Click="this.HandleCancel" />
                    <RadzenButton Text="Save" Icon="save" IsBusy="@this._isSaving" ButtonStyle="ButtonStyle.Primary" Click="this.HandleSaveAsync" />
                </div>
        </RadzenStack>
    </PersistentModalShell>
}
