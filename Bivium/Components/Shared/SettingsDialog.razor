@namespace Bivium.Components.Shared

@if (this._isVisible)
{
    <PersistentModalShell Surface="extensions" Label="Editor Extensions" OnCancel="this.HandleCancel" CanClose="@(!this._binding.Rejected)" OnContentRendered="this.HandleContentRenderedAsync">
        <div data-workspace-workflow-id="@this.Workflow.Id">
        <RadzenTemplateForm TItem="SettingsDialog" Data="this" Submit="@(_ => this.HandleSave())">
        <RadzenStack class="bivium-radzen-modal" Gap="1rem" Style="width:100%;max-height:calc(100dvh - 9rem);box-sizing:border-box;">
                <RadzenText TextStyle="TextStyle.Body1" Text="One extension per line, including the dot (e.g. .txt)" />
                <RadzenFormField Text="File extensions" Component="editor-extensions-textarea" Style="width:100%;">
                    <RadzenTextArea id="editor-extensions-textarea" Name="editor-extensions-textarea" @ref="this._textareaElement" @bind-Value="this._extensionsText" @bind-Value:after="this.PublishDraft" Immediate="true" Rows="12" Style="width:100%;resize:vertical;" />
                </RadzenFormField>
                @if (!string.IsNullOrEmpty(this._statusText))
                {
                    <RadzenAlert AlertStyle="AlertStyle.Danger" Shade="Shade.Lighter">@this._statusText</RadzenAlert>
                }
                @if (!string.IsNullOrEmpty(this._binding.Error))
                {
                    <RadzenAlert AlertStyle="AlertStyle.Warning">@this._binding.Error</RadzenAlert>
                }
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" AlignItems="AlignItems.Center" Gap="0.75rem">
                    <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="this.HandleCancel" />
                    <RadzenButton Text="Save" Icon="save" ButtonType="ButtonType.Submit" Disabled="@this._binding.Rejected" ButtonStyle="ButtonStyle.Primary" />
                </RadzenStack>
        </RadzenStack>
        </RadzenTemplateForm>
        </div>
    </PersistentModalShell>
}
