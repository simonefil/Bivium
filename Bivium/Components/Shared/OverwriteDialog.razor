@namespace Bivium.Components.Shared
@implements IDisposable
@inject Bivium.Services.BiviumWorkspaceService WorkspaceService

@if (this.Workflow?.Phase is Bivium.Models.WorkspaceWorkflowPhase.AwaitingOverwrite or Bivium.Models.WorkspaceWorkflowPhase.Failed)
{
    <PersistentModalShell Surface="overwrite" @key="this.Workflow.QuestionId" Label="@(this.Workflow.Phase == Bivium.Models.WorkspaceWorkflowPhase.Failed ? "Transfer failed" : this.CurrentConflict?.Title)" Width="min(92vw, 52rem)" CloseOnOverlayClick="true" OnCancel="@(() => this.RespondWorkspaceAsync(Bivium.Models.OverwriteChoice.No))">
        <div data-workspace-workflow-id="@this.Workflow.Id">
            <RadzenStack Gap="1rem">
                @if (this.Workflow.Phase == Bivium.Models.WorkspaceWorkflowPhase.Failed)
                {
                    <RadzenAlert AlertStyle="AlertStyle.Danger" AllowClose="false" class="rz-m-0" Style="white-space: pre-wrap;">@this.Workflow.ErrorMessage</RadzenAlert>
                }
                else
                {
                    <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Div" class="rz-m-0" Style="white-space: pre-wrap;">@this.CurrentConflict?.Message</RadzenText>
                }
                @if (!string.IsNullOrEmpty(this._workspaceError))
                {
                    <RadzenAlert AlertStyle="AlertStyle.Warning" AllowClose="false" class="rz-m-0">@this._workspaceError</RadzenAlert>
                }
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" AlignItems="AlignItems.Center" Gap="0.75rem">
                    @if (this.Workflow.Phase == Bivium.Models.WorkspaceWorkflowPhase.Failed)
                    {
                        <RadzenButton Text="Close" ButtonStyle="ButtonStyle.Primary" Click="@(() => this.RespondWorkspaceAsync(Bivium.Models.OverwriteChoice.No))" />
                    }
                    else
                    {
                        <RadzenButton Text="No" ButtonStyle="ButtonStyle.Light" Click="@(() => this.RespondWorkspaceAsync(Bivium.Models.OverwriteChoice.No))" />
                        <RadzenButton Text="Yes to all" ButtonStyle="ButtonStyle.Danger" Click="@(() => this.RespondWorkspaceAsync(Bivium.Models.OverwriteChoice.YesToAll))" />
                        <RadzenButton Text="Yes" ButtonStyle="ButtonStyle.Primary" Click="@(() => this.RespondWorkspaceAsync(Bivium.Models.OverwriteChoice.Yes))" />
                    }
                </RadzenStack>
            </RadzenStack>
        </div>
    </PersistentModalShell>
}

@code {
    /// <summary>Conflitto corrente catturato dal workspace, senza reinvocazione del paste</summary>
    [Parameter] public Bivium.Models.WorkspaceWorkflowSnapshot Workflow { get; set; }
    /// <summary>Attachment dell'adapter corrente</summary>
    [Parameter] public string AttachmentId { get; set; } = "";
    /// <summary>Generazione del lease corrente</summary>
    [Parameter] public long LeaseGeneration { get; set; }
    /// <summary>Domanda montata e risposta stabile per le ritrasmissioni</summary>
    private Guid _workspaceQuestionId;
    /// <summary>Risposta catturata per la sola decisione corrente</summary>
    private Bivium.Models.WorkspaceWorkflowResponse _workspaceResponse;
    /// <summary>Errore di risposta senza retry implicito</summary>
    private string _workspaceError = "";
    /// <summary>Dispose non decide No e non cancella l'operazione</summary>
    private bool _workspaceDisposed;
    /// <summary>Conflitto corrente; null quando il workflow è già avanzato oltre l'ultima domanda e Radzen ri-renderizza il contenuto prima della chiusura</summary>
    private Bivium.Models.WorkspaceOverwriteQuestion CurrentConflict => this.Workflow == null || this.Workflow.Conflicts.IsDefault || this.Workflow.ConflictIndex >= this.Workflow.Conflicts.Length ? null : this.Workflow.Conflicts[this.Workflow.ConflictIndex];

    /// <summary>Proietta la domanda già materializzata, senza ricalcolare conflitti</summary>
    protected override void OnParametersSet()
    {
        if (this.Workflow == null || this._workspaceQuestionId == this.Workflow.QuestionId)
            return;
        this._workspaceQuestionId = this.Workflow.QuestionId;
        this._workspaceResponse = null;
        this._workspaceError = "";
    }

    /// <summary>Decisione esatta per questa domanda; Escape conserva il No legacy</summary>
    /// <param name="choice">Decisione esplicita dell'utente</param>
    /// <returns>Completamento del callback adapter</returns>
    private System.Threading.Tasks.Task RespondWorkspaceAsync(Bivium.Models.OverwriteChoice choice)
    {
        if (this._workspaceDisposed || this.Workflow?.Phase is not (Bivium.Models.WorkspaceWorkflowPhase.AwaitingOverwrite or Bivium.Models.WorkspaceWorkflowPhase.Failed))
            return System.Threading.Tasks.Task.CompletedTask;
        bool failed = this.Workflow.Phase == Bivium.Models.WorkspaceWorkflowPhase.Failed;
        Bivium.Models.OverwriteChoice? decision = failed ? null : choice;
        if (this._workspaceResponse != null && this._workspaceResponse.Overwrite != decision)
            this._workspaceResponse = null;
        this._workspaceResponse ??= new Bivium.Models.WorkspaceWorkflowResponse(this.Workflow.Id, this.Workflow.Revision, this.Workflow.QuestionId, Guid.NewGuid(), failed, "", decision);
        Bivium.Models.WorkspaceWorkflowResponseResult result = this.WorkspaceService.RespondToWorkflow(new Bivium.Models.WorkspaceClientToken(this.AttachmentId, this.LeaseGeneration), this._workspaceResponse);
        if (result is Bivium.Models.WorkspaceWorkflowResponseResult.Stale or Bivium.Models.WorkspaceWorkflowResponseResult.Denied)
            this._workspaceError = "This response was not accepted. The authoritative workflow is unchanged.";
        return System.Threading.Tasks.Task.CompletedTask;
    }

    /// <summary>Verifica la domanda acknowledged senza attendere copy o move</summary>
    /// <param name="cancellationToken">Lifecycle del drain</param>
    /// <returns>True per domanda corrente o operazione già ammessa</returns>
    internal System.Threading.Tasks.Task<bool> FlushForHandoffAsync(System.Threading.CancellationToken cancellationToken)
    {
        cancellationToken.ThrowIfCancellationRequested();
        Bivium.Models.WorkspaceWorkflowSnapshot current = this.WorkspaceService.GetWorkflow(new Bivium.Models.WorkspaceClientToken(this.AttachmentId, this.LeaseGeneration));
        return System.Threading.Tasks.Task.FromResult(!this._workspaceDisposed && current != null && current.Id == this.Workflow?.Id && ((current.QuestionId == this.Workflow.QuestionId && current.Revision == this.Workflow.Revision) || current.Phase is Bivium.Models.WorkspaceWorkflowPhase.Running or Bivium.Models.WorkspaceWorkflowPhase.Succeeded or Bivium.Models.WorkspaceWorkflowPhase.Cancelled));
    }

    /// <summary>Detach del solo adapter; non decide No e non cancella l'operazione</summary>
    public void Dispose()
    {
        this._workspaceDisposed = true;
    }
}
