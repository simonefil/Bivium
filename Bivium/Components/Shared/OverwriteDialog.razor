@namespace Bivium.Components.Shared
@implements IDisposable
@inject DialogService DialogService
@inject ILogger<OverwriteDialog> Logger

@code {
    /// <summary>
    /// Callback che riceve la scelta di sovrascrittura
    /// </summary>
    [Parameter]
    public EventCallback<OverwriteChoice> OnClose { get; set; }

    /// <summary>
    /// Versione dell'apertura corrente
    /// </summary>
    private int _generation;

    /// <summary>
    /// Tracker dell'apertura posseduta
    /// </summary>
    private RadzenDialogLifetime _lifetime;

    /// <summary>
    /// Inizializza il tracker del dialog
    /// </summary>
    protected override void OnInitialized()
    {
        this._lifetime = new RadzenDialogLifetime(this.DialogService);
    }

    /// <summary>
    /// Apre il dialog di sovrascrittura mantenendo il contratto sincrono legacy
    /// </summary>
    /// <param name="title">Titolo del dialog</param>
    /// <param name="message">Descrizione del conflitto</param>
    /// <param name="defaultYes">Indica se Sì è l'azione predefinita</param>
    public void Show(string title, string message, bool defaultYes = true)
    {
        if (this._lifetime.IsDisposed || this._lifetime.IsOpen())
            return;

        int generation = ++this._generation;
        _ = this.ObserveTaskAsync(this.ShowAsync(generation, title, message, defaultYes), "apertura sovrascrittura");
    }

    /// <summary>
    /// Nasconde soltanto l'apertura posseduta quando è in cima allo stack
    /// </summary>
    public void Hide()
    {
        this._generation++;
        this._lifetime.RequestClose();
    }

    /// <summary>
    /// Apre e attende il risultato del dialog Radzen
    /// </summary>
    /// <param name="generation">Versione dell'apertura</param>
    /// <param name="title">Titolo del dialog</param>
    /// <param name="message">Descrizione del conflitto</param>
    /// <param name="defaultYes">Indica se Sì è l'azione predefinita</param>
    private async System.Threading.Tasks.Task ShowAsync(int generation, string title, string message, bool defaultYes)
    {
        DialogOptions options = new DialogOptions
        {
            Width = "min(92vw, 52rem)",
            ShowClose = false,
            CloseDialogOnEsc = true,
            CloseDialogOnOverlayClick = true,
            AutoFocusFirstElement = true,
            CssClass = "bivium-radzen-service-dialog",
            WrapperCssClass = "bivium-modal-layer"
        };
        this._lifetime.Begin(options);
        object result;
        try
        {
            result = await this.DialogService.OpenAsync(title, service => @<div>
                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Div" class="rz-m-0" Style="white-space: pre-wrap;">@message</RadzenText>
                <div class="bivium-radzen-dialog-actions">
                    <RadzenButton Text="No" ButtonStyle="@(defaultYes ? ButtonStyle.Light : ButtonStyle.Primary)" Click="@(() => service.Close(OverwriteChoice.No))" />
                    <RadzenButton Text="Yes to all" ButtonStyle="ButtonStyle.Secondary" Click="@(() => service.Close(OverwriteChoice.YesToAll))" />
                    <RadzenButton Text="Yes" ButtonStyle="@(defaultYes ? ButtonStyle.Primary : ButtonStyle.Light)" Click="@(() => service.Close(OverwriteChoice.Yes))" />
                </div>
            </div>, options);
        }
        finally
        {
            this._lifetime.Complete(options);
        }
        if (generation != this._generation)
            return;

        OverwriteChoice choice = result is OverwriteChoice value ? value : OverwriteChoice.No;
        await this.OnClose.InvokeAsync(choice);
    }

    /// <summary>
    /// Osserva e registra le eccezioni del task avviato da <see cref="Show"/>
    /// </summary>
    /// <param name="task">Task da osservare</param>
    /// <param name="operation">Descrizione usata nel log</param>
    private async System.Threading.Tasks.Task ObserveTaskAsync(System.Threading.Tasks.Task task, string operation)
    {
        try
        {
            await task;
        }
        catch (Exception ex)
        {
            this.Logger.LogError(ex, "Errore durante {Operation} Radzen", operation);
        }
    }

    /// <summary>
    /// Rilascia il tracker senza chiudere dialog altrui
    /// </summary>
    public void Dispose()
    {
        this._generation++;
        this._lifetime?.Dispose();
    }
}
