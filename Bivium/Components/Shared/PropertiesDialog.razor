@namespace Bivium.Components.Shared
@inject BiviumWorkspaceService WorkspaceService
@inject NotificationService NotificationService
@using System.Text.Json

@if (this.Workflow?.Kind == WorkspaceWorkflowKind.Properties && this.Workflow.IsActive && this._draft != null)
{
    <PersistentModalShell Surface="properties" Label="@("Properties - " + this._draft.Entry.Name)" CloseOnOverlayClick="true" OnCancel="this.CloseAsync">
        <div data-workspace-workflow-id="@this.Workflow.Id">
            <RadzenStack Gap="0.5rem">
                <RadzenRow><RadzenColumn Size="3"><strong>Name</strong></RadzenColumn><RadzenColumn Size="9">@this._draft.Entry.Name</RadzenColumn></RadzenRow>
                <RadzenRow><RadzenColumn Size="3"><strong>Path</strong></RadzenColumn><RadzenColumn Size="9" Style="overflow-wrap:anywhere;">@this._draft.Entry.FullPath</RadzenColumn></RadzenRow>
                <RadzenRow><RadzenColumn Size="3"><strong>Type</strong></RadzenColumn><RadzenColumn Size="9">@(this._draft.Entry.IsDirectory ? "Directory" : "File")</RadzenColumn></RadzenRow>
                <RadzenRow><RadzenColumn Size="3"><strong>Size</strong></RadzenColumn><RadzenColumn Size="9">@this.RenderSize()</RadzenColumn></RadzenRow>
                <RadzenRow><RadzenColumn Size="3"><strong>Modified</strong></RadzenColumn><RadzenColumn Size="9">@this._draft.Entry.FormatDate()</RadzenColumn></RadzenRow>
                <RadzenRow><RadzenColumn Size="3"><strong>Attributes</strong></RadzenColumn><RadzenColumn Size="9">@this._draft.Entry.Attributes</RadzenColumn></RadzenRow>
                @if (this._draft.Permissions != null)
                {
                    <RadzenRow><RadzenColumn Size="3"><strong>Owner</strong></RadzenColumn><RadzenColumn Size="9">@this._draft.Permissions.Owner</RadzenColumn></RadzenRow>
                    @if (this._draft.Permissions.IsUnix)
                    {
                        <RadzenRow><RadzenColumn Size="3"><strong>Group</strong></RadzenColumn><RadzenColumn Size="9">@this._draft.Permissions.Group</RadzenColumn></RadzenRow>
                    }
                    <RadzenRow><RadzenColumn Size="3"><strong>Permissions</strong></RadzenColumn><RadzenColumn Size="9">@this._draft.Permissions.ToDisplayString()</RadzenColumn></RadzenRow>
                }
                @if (this._draft.Entry.IsDirectory && this._draft.Size < 0 && this.Workflow.Phase == WorkspaceWorkflowPhase.AwaitingInput)
                {
                    <RadzenButton Text="Calculate size" Icon="calculate" Click="this.CalculateAsync" />
                }
                @if (this.Workflow.Phase == WorkspaceWorkflowPhase.Running)
                {
                    <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" ShowValue="false" />
                    @if (this.Operation != null)
                    {
                        <RadzenText Text="@(this.Operation.ProgressCurrent.ToString("N0") + " files visited")" />
                    }
                    <RadzenButton Text="Cancel calculation" Icon="stop" ButtonStyle="ButtonStyle.Light" Click="this.CancelCalculation" />
                }
                @if (!string.IsNullOrEmpty(this.Workflow.ErrorMessage))
                {
                    <RadzenAlert AlertStyle="AlertStyle.Danger">@this.Workflow.ErrorMessage</RadzenAlert>
                }
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" AlignItems="AlignItems.Center" Gap="0.75rem" class="rz-mt-4"><RadzenButton Text="OK" ButtonStyle="ButtonStyle.Primary" Click="this.CloseAsync" /></RadzenStack>
            </RadzenStack>
        </div>
    </PersistentModalShell>
}

@code {
    [Parameter] public WorkspaceWorkflowSnapshot Workflow { get; set; }
    [Parameter] public WorkspaceOperationSnapshot Operation { get; set; }
    [Parameter] public string AttachmentId { get; set; } = "";
    [Parameter] public long LeaseGeneration { get; set; }
    private readonly WorkspaceFormBinding _binding = new WorkspaceFormBinding();
    private WorkspacePropertiesDraft _draft;

    /// <summary>Il mount legge il risultato, non riavvia il calcolo</summary>
    protected override void OnParametersSet()
    {
        if (this._binding.Adopt(this.Workflow, this.LeaseGeneration))
            this._draft = JsonSerializer.Deserialize<WorkspacePropertiesDraft>(this.Workflow.Draft);
    }

    private System.Threading.Tasks.Task CalculateAsync()
    {
        this._binding.Respond(this.WorkspaceService, new WorkspaceClientToken(this.AttachmentId, this.LeaseGeneration), false);
        return System.Threading.Tasks.Task.CompletedTask;
    }

    private System.Threading.Tasks.Task CloseAsync()
    {
        this._binding.Respond(this.WorkspaceService, new WorkspaceClientToken(this.AttachmentId, this.LeaseGeneration), true);
        return System.Threading.Tasks.Task.CompletedTask;
    }

    private void CancelCalculation()
    {
        if (this.Operation != null && !this.WorkspaceService.TryCancelWorkspaceOperation(new WorkspaceClientToken(this.AttachmentId, this.LeaseGeneration), this.Operation.Id, this.Operation.Revision))
            this.NotificationService.Notify(NotificationSeverity.Warning, "Cancellation not accepted", "The authoritative operation is unchanged.", 8000);
    }

    internal System.Threading.Tasks.Task<bool> FlushForHandoffAsync(CancellationToken cancellationToken) => this._binding.FlushAsync(this.WorkspaceService, new WorkspaceClientToken(this.AttachmentId, this.LeaseGeneration), this._binding.Current.Draft, cancellationToken);

    /// <summary>Formattazione UI dei dati già calcolati dal servizio</summary>
    private string RenderSize()
    {
        FileSystemEntry entry = this._draft.Entry;
        if (!entry.IsDirectory)
            return entry.FormatSize() + " (" + entry.SizeBytes.ToString("N0") + " bytes)";
        if (this.Workflow.Phase == WorkspaceWorkflowPhase.Running)
            return "Calculating...";
        if (this._draft.Size < 0)
            return "<DIR>";
        long size = this._draft.Size;
        string formatted = ByteSizeFormatter.Format(size);
        return formatted + " (" + this._draft.FileCount.ToString("N0") + " files, " + this._draft.DirectoryCount.ToString("N0") + " folders)";
    }
}
