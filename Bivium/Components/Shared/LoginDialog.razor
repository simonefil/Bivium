@namespace Bivium.Components.Shared
@inject IJSRuntime JSRuntime

<div style="display:grid;place-items:center;height:100dvh;padding:1rem;box-sizing:border-box;overflow:auto;">
    <RadzenCard Style="width:min(100%,28rem);">
        <RadzenTemplateForm TItem="LoginDialog" Data="this" Submit="@(_ => this.HandleLogin())">
        <RadzenStack Gap="1rem">
            <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" Text="Login" />
            <RadzenText TextStyle="TextStyle.Body1" Text="Sign in with the configured administrator credentials." />
            <RadzenFormField Text="Username" Component="login-username" Style="width:100%;"><RadzenTextBox id="login-username" Name="login-username" @ref="this._usernameInput" @bind-Value="this._username" Immediate="true" Disabled="@this._isSubmitting" Style="width:100%;" autocomplete="username" /></RadzenFormField>
            <RadzenFormField Text="Password" Component="login-password" Style="width:100%;"><RadzenPassword id="login-password" Name="login-password" @bind-Value="this._password" Immediate="true" Disabled="@this._isSubmitting" Style="width:100%;" autocomplete="current-password" /></RadzenFormField>
            @if (this.RequiresTwoFactor)
            {
                <RadzenFormField Text="2FA code" Component="login-token" Style="width:100%;"><ChildContent><RadzenTextBox id="login-token" Name="login-token" @bind-Value="this._twoFactorCode" Immediate="true" Disabled="@this._isSubmitting" Style="width:100%;" autocomplete="one-time-code" inputmode="numeric" /></ChildContent><Helper>Enter the current code from your authenticator.</Helper></RadzenFormField>
            }
            @if (!string.IsNullOrEmpty(this._statusText))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Shade="Shade.Lighter">@this._statusText</RadzenAlert>
            }
            <div class="bivium-radzen-dialog-actions"><RadzenButton Text="Login" Icon="login" IsBusy="@this._isSubmitting" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" /></div>
        </RadzenStack>
        </RadzenTemplateForm>
    </RadzenCard>
</div>
