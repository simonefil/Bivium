@namespace Bivium.Components.Shared

<div class="bivium-radzen-menu-bar">
    <RadzenMenu id="workspace-application-menu" Responsive="true" ToggleAriaLabel="Toggle menu" ClickToOpen="true" AriaLabel="Application menu" Click="this.HandleMenuClick">
        <RadzenMenuItem id="menu-file" Text="File">
            <RadzenMenuItem id="menu-file-new-file" Text="New File" Icon="note_add" Disabled="@(!this.IsEnabled("new-file"))" Template="@this.CommandTemplate("new-file")" Value="@("new-file")" />
            <RadzenMenuItem id="menu-file-new-folder" Text="New Folder" Icon="create_new_folder" Disabled="@(!this.IsEnabled("new-folder"))" Template="@this.CommandTemplate("new-folder")" Value="@("new-folder")" />
            <RadzenMenuItem id="menu-file-download" Text="@(this.IsMultiSelection ? "Download as ZIP" : "Download")" Icon="download" Disabled="@(!this.IsEnabled("download"))" Value="@("download")" />
            <RadzenMenuItem id="menu-file-upload" Text="Upload" Icon="upload" Disabled="@(!this.IsEnabled("upload"))" Value="@("upload")" />
            @if (this.CanLogout)
            {
                <RadzenMenuItem id="menu-file-logout" Text="Logout" Icon="logout" Disabled="@(!this.IsEnabled("logout"))" Value="@("logout")" />
            }
            <RadzenMenuItem id="menu-file-extract" Text="Extract Here" Icon="unarchive" Disabled="@(!this.IsEnabled("extract"))" Value="@("extract")" />
            <RadzenMenuItem id="menu-file-compress" Text="Compress to..." Icon="archive" Disabled="@(!this.IsEnabled("compress"))" Value="@("compress")" />
            <RadzenMenuItem id="menu-file-reset" Text="Reset Workspace..." Icon="restart_alt" Disabled="@(!this.IsEnabled("reset"))" Value="@("reset")" />
        </RadzenMenuItem>
        <RadzenMenuItem id="menu-edit" Text="Edit">
            <RadzenMenuItem id="menu-edit-copy" Text="Copy" Icon="content_copy" Disabled="@(!this.IsEnabled("copy"))" Template="@this.CommandTemplate("copy")" Value="@("copy")" />
            <RadzenMenuItem id="menu-edit-cut" Text="Cut" Icon="content_cut" Disabled="@(!this.IsEnabled("cut"))" Template="@this.CommandTemplate("cut")" Value="@("cut")" />
            <RadzenMenuItem id="menu-edit-paste" Text="Paste" Icon="content_paste" Disabled="@(!this.IsEnabled("paste"))" Template="@this.CommandTemplate("paste")" Value="@("paste")" />
            <RadzenMenuItem id="menu-edit-delete" Text="Delete" Icon="delete" Disabled="@(!this.IsEnabled("delete"))" Template="@this.CommandTemplate("delete")" Value="@("delete")" />
            <RadzenMenuItem id="menu-edit-rename" Text="Rename" Icon="drive_file_rename_outline" Disabled="@(!this.IsEnabled("rename"))" Template="@this.CommandTemplate("rename")" Value="@("rename")" />
            <RadzenMenuItem id="menu-edit-advanced-rename" Text="Advanced Rename..." Icon="edit_note" Disabled="@(!this.IsEnabled("advanced-rename"))" Template="@this.CommandTemplate("advanced-rename")" Value="@("advanced-rename")" />
            <RadzenMenuItem id="menu-edit-select-all" Text="Select All" Icon="select_all" Disabled="@(!this.IsEnabled("select-all"))" Template="@this.CommandTemplate("select-all")" Value="@("select-all")" />
        </RadzenMenuItem>
        <RadzenMenuItem id="menu-view" Text="View">
            <RadzenMenuItem id="menu-view-refresh" Text="Refresh" Icon="refresh" Disabled="@(!this.IsEnabled("refresh"))" Template="@this.CommandTemplate("refresh")" Value="@("refresh")" />
            <RadzenMenuItem id="menu-view-panels" Text="@(this.SinglePanelMode ? "Dual Panel" : "Single Panel")" Icon="view_column" Disabled="@(!this.IsEnabled("panels"))" Template="@this.CommandTemplate("panels", this.SinglePanelMode ? "Dual Panel" : "Single Panel")" Value="@("panels")" />
            <RadzenMenuItem id="menu-view-terminal" Text="@(this.TerminalNeedsAttention ? "Terminal — attention" : this.TerminalMinimized ? "Terminal — minimized" : this.TerminalVisible ? "Terminal — visible" : "Terminal")" Icon="@(this.TerminalNeedsAttention ? "notification_important" : "terminal")" Disabled="@(!this.IsEnabled("terminal"))" Template="@this.CommandTemplate("terminal", this.TerminalNeedsAttention ? "Terminal — attention" : this.TerminalMinimized ? "Terminal — minimized" : this.TerminalVisible ? "Terminal — visible" : "Terminal")" Value="@("terminal")" />
        </RadzenMenuItem>
        <RadzenMenuItem id="menu-settings" Text="Settings">
            <RadzenMenuItem id="menu-settings-theme" Text="Theme" Icon="palette" Disabled="@(!this.IsEnabled("theme"))">
                @foreach (string theme in this.GetThemeOptions())
                {
                    <RadzenMenuItem id="@("menu-settings-theme-" + theme)" Text="@this.FormatThemeName(theme)"
                                    Icon="@(string.Equals(this.GetCurrentTheme(), theme, StringComparison.OrdinalIgnoreCase) ? "check" : "")"
                                    Disabled="@(!this.IsEnabled("theme"))" Value="@(ThemeValuePrefix + theme)" />
                }
            </RadzenMenuItem>
            <RadzenMenuItem id="menu-settings-editor" Text="Editor Extensions..." Icon="code" Disabled="@(!this.IsEnabled("editor-extensions"))" Value="@("editor-extensions")" />
            <RadzenMenuItem id="menu-settings-permissions" Text="Default Permissions..." Icon="admin_panel_settings" Disabled="@(!this.IsEnabled("creation-permissions"))" Value="@("creation-permissions")" />
            @if (this.CanManageAuthenticationSettings)
            {
                <RadzenMenuItem id="menu-settings-auth" Text="Authentication..." Icon="lock" Disabled="@(!this.IsEnabled("authentication"))" Value="@("authentication")" />
            }
        </RadzenMenuItem>
        <RadzenMenuItem id="menu-help" Text="Help">
            <RadzenMenuItem id="menu-help-about" Text="About" Icon="help" Disabled="@(!this.IsEnabled("about"))" Template="@this.CommandTemplate("about")" Value="@("about")" />
        </RadzenMenuItem>
    </RadzenMenu>
</div>

@code {
    /// <summary>Native template: icon managed by Radzen, label followed by the badge</summary>
    /// <param name="id">Identifier in the received projection</param>
    /// <param name="label">Optional dynamic label</param>
    /// <returns>Semantic label without nested controls</returns>
    private RenderFragment CommandTemplate(string id, string label = null) => @<CommandMenuLabel Label="@(label ?? this.GetCommand(id)?.Label)" Shortcut="@this.GetCommand(id)?.Shortcut" />;
}
