@namespace Bivium.Components.Shared

<div class="bivium-radzen-menu-bar" @ref="this._radzenMenuHost">
    <RadzenMenu Responsive="true" ClickToOpen="true" Flyout="true" AriaLabel="Application menu">
        <RadzenMenuItem id="menu-file" Text="File">
            <RadzenMenuItem id="menu-file-new-file" Text="New File" Icon="note_add" Click="async _ => await this.HandleNewFile()" />
            <RadzenMenuItem id="menu-file-new-folder" Text="New Folder" Icon="create_new_folder" Click="async _ => await this.HandleNewFolder()" />
            <RadzenMenuItem id="menu-file-download" Text="@(this.IsMultiSelection ? "Download as ZIP" : "Download")" Icon="download" Click="async _ => await this.HandleDownload()" />
            <RadzenMenuItem id="menu-file-upload" Text="Upload" Icon="upload" Click="async _ => await this.HandleUpload()" />
            @if (this.CanLogout)
            {
                <RadzenMenuItem id="menu-file-logout" Text="Logout" Icon="logout" Click="async _ => await this.HandleLogout()" />
            }
            @if (this.CanExtract)
            {
                <RadzenMenuItem id="menu-file-extract" Text="Extract Here" Icon="unarchive" Click="async _ => await this.HandleExtract()" />
            }
            @if (this.CanCompress)
            {
                <RadzenMenuItem id="menu-file-compress" Text="Compress to..." Icon="archive" Click="async _ => await this.HandleCompress()" />
            }
            <RadzenMenuItem id="menu-file-reset" Text="Reset Workspace..." Icon="restart_alt" Click="async _ => await this.HandleResetWorkspace()" />
            <RadzenMenuItem id="menu-file-exit" Text="Exit" Icon="close" Click="async _ => await this.HandleExit()" />
        </RadzenMenuItem>
        <RadzenMenuItem id="menu-edit" Text="Edit">
            <RadzenMenuItem id="menu-edit-copy" Text="Copy" Icon="content_copy" Click="async _ => await this.HandleCopy()" />
            <RadzenMenuItem id="menu-edit-cut" Text="Cut" Icon="content_cut" Click="async _ => await this.HandleCut()" />
            <RadzenMenuItem id="menu-edit-paste" Text="Paste" Icon="content_paste" Click="async _ => await this.HandlePaste()" />
            <RadzenMenuItem id="menu-edit-delete" Text="Delete" Icon="delete" Click="async _ => await this.HandleDelete()" />
            @if (!this.IsMultiSelection)
            {
                <RadzenMenuItem id="menu-edit-rename" Text="Rename" Icon="drive_file_rename_outline" Click="async _ => await this.HandleRename()" />
            }
            <RadzenMenuItem id="menu-edit-advanced-rename" Text="Advanced Rename..." Icon="edit_note" Click="async _ => await this.HandleAdvancedRename()" />
            <RadzenMenuItem id="menu-edit-select-all" Text="Select All" Icon="select_all" Click="async _ => await this.HandleSelectAll()" />
        </RadzenMenuItem>
        <RadzenMenuItem id="menu-view" Text="View">
            <RadzenMenuItem id="menu-view-refresh" Text="Refresh" Icon="refresh" Click="async _ => await this.HandleRefresh()" />
            <RadzenMenuItem id="menu-view-panels" Text="@(this.SinglePanelMode ? "Dual Panel" : "Single Panel")" Icon="view_column" Click="async _ => await this.HandleToggleSinglePanel()" />
            <RadzenMenuItem id="menu-view-terminal" Text="@(this.TerminalNeedsAttention ? "Terminal — attention" : this.TerminalMinimized ? "Terminal — minimized" : this.TerminalVisible ? "Terminal — visible" : "Terminal")" Icon="@(this.TerminalNeedsAttention ? "notification_important" : "terminal")" Click="async _ => await this.HandleTerminal()" />
        </RadzenMenuItem>
        <RadzenMenuItem id="menu-settings" Text="Settings">
            <RadzenMenuItem id="menu-settings-theme" Text="Theme" Icon="palette">
                @foreach (string theme in this.GetThemeOptions())
                {
                    <RadzenMenuItem id="@("menu-settings-theme-" + theme)" Text="@this.FormatThemeName(theme)"
                                    Icon="@(string.Equals(this.GetCurrentTheme(), theme, StringComparison.OrdinalIgnoreCase) ? "check" : "")"
                                    Click="async _ => await this.HandleThemeChange(new ChangeEventArgs { Value = theme })" />
                }
            </RadzenMenuItem>
            <RadzenMenuItem id="menu-settings-editor" Text="Editor Extensions..." Icon="code" Click="async _ => await this.HandleEditorExtensions()" />
            <RadzenMenuItem id="menu-settings-permissions" Text="Default Permissions..." Icon="admin_panel_settings" Click="async _ => await this.HandleCreationPermissions()" />
            @if (this.CanManageAuthenticationSettings)
            {
                <RadzenMenuItem id="menu-settings-auth" Text="Authentication..." Icon="lock" Click="async _ => await this.HandleAuthenticationSettings()" />
            }
        </RadzenMenuItem>
        <RadzenMenuItem id="menu-help" Text="Help">
            <RadzenMenuItem id="menu-help-about" Text="About" Icon="help" Click="async _ => await this.HandleAbout()" />
        </RadzenMenuItem>
    </RadzenMenu>
</div>
