@namespace Bivium.Components.Shared
@inject Bivium.Services.IFileSystemService FileSystemService
@inject TooltipService TooltipService

<div class="bivium-radzen-status-bar rz-p-1" role="status">
    <span class="bivium-status-selection" @ref="this._selectionElement" @onmouseenter="@(() => this.ShowTooltip(this._selectionElement, this._selectionInfo))" aria-label="@this._selectionInfo"><RadzenText TagName="TagName.Span" TextStyle="TextStyle.Body2" Text="@this._selectionInfo" class="rz-m-0" /></span>
    <div class="bivium-status-shortcuts" aria-label="Available keyboard shortcuts">
        @foreach (string shortcutId in s_shortcutIds)
        {
            CommanderCommandState command = this.GetCommand(shortcutId);
            @if (command != null && command.Enabled && !string.IsNullOrEmpty(command.Shortcut))
            {
                <span @key="command.Id" class="bivium-status-shortcut rz-text-body2 rz-m-0">
                    <RadzenBadge BadgeStyle="BadgeStyle.Base" Variant="Variant.Flat" Style="font-size:inherit" Text="@this.GetVisualShortcut(command)" />
                    <RadzenText TagName="TagName.Span" TextStyle="TextStyle.Body2" Text="@command.Label" class="rz-m-0" />
                </span>
            }
        }
    </div>
    @if (!string.IsNullOrEmpty(this._progressText) || this.CanCancelOperation)
    {
        <span class="bivium-radzen-status-progress" @ref="this._progressElement" @onmouseenter="@(() => this.ShowTooltip(this._progressElement, this._progressText))" aria-label="@this._progressText">
            <RadzenText TagName="TagName.Span" TextStyle="TextStyle.Body2" Text="@this._progressText" class="rz-m-0" />
            @if (this.CanCancelOperation)
            {
                <RadzenButton ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.ExtraSmall" Icon="cancel" Text="Cancel" Click="this.OnCancelOperation" MouseEnter="@(element => this.ShowTooltip(element, "Cancel the running operation"))" aria-label="Cancel the running operation" />
            }
        </span>
    }
    <span class="bivium-status-disk" @ref="this._diskElement" @onmouseenter="@(() => this.ShowTooltip(this._diskElement, this._diskInfo))" aria-label="@this._diskInfo"><RadzenText TagName="TagName.Span" TextStyle="TextStyle.Body2" Text="@this._diskInfo" class="rz-m-0" /></span>
</div>

@code {
    private ElementReference _selectionElement;
    private ElementReference _progressElement;
    private ElementReference _diskElement;

    private void ShowTooltip(ElementReference element, string text)
    {
        if (!string.IsNullOrEmpty(text))
            this.TooltipService.Open(element, text, new TooltipOptions { Delay = 500, Duration = 4000, Position = TooltipPosition.Top });
    }
}
