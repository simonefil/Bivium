@namespace Bivium.Components.Shared
@inject BiviumWorkspaceService WorkspaceService
@using System.Text.Json

@if (this.Workflow?.Kind == WorkspaceWorkflowKind.About && this.Workflow.IsActive && this._draft != null)
{
    <PersistentModalShell Surface="about" Label="About" Width="min(92vw, 48rem)" CloseOnOverlayClick="true" OnCancel="this.CloseAsync">
        <div data-workspace-workflow-id="@this.Workflow.Id">
            <RadzenStack Gap="0.5rem">
                <RadzenRow><RadzenColumn Size="4"><strong>Name</strong></RadzenColumn><RadzenColumn Size="8"><img src="favicon-32x32.png" alt="" /> Bivium File Manager</RadzenColumn></RadzenRow>
                <RadzenRow><RadzenColumn Size="4"><strong>Version</strong></RadzenColumn><RadzenColumn Size="8">@this._draft.Version</RadzenColumn></RadzenRow>
                <RadzenRow><RadzenColumn Size="4"><strong>License</strong></RadzenColumn><RadzenColumn Size="8">GNU General Public License v3.0</RadzenColumn></RadzenRow>
                <RadzenRow><RadzenColumn Size="4"><strong>Repository</strong></RadzenColumn><RadzenColumn Size="8"><RadzenLink data-ui-key="repository-link" Path="https://github.com/simonefil/Bivium" Target="_blank" Text="github.com/simonefil/Bivium" /></RadzenColumn></RadzenRow>
                <RadzenRow><RadzenColumn Size="4"><strong>Runtime</strong></RadzenColumn><RadzenColumn Size="8">@this._draft.Runtime</RadzenColumn></RadzenRow>
                <RadzenRow><RadzenColumn Size="4"><strong>Platform</strong></RadzenColumn><RadzenColumn Size="8">@this._draft.Platform</RadzenColumn></RadzenRow>
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" AlignItems="AlignItems.Center" Gap="0.75rem" class="rz-mt-4"><RadzenButton Text="OK" ButtonStyle="ButtonStyle.Primary" Click="this.CloseAsync" /></RadzenStack>
            </RadzenStack>
        </div>
    </PersistentModalShell>
}

@code {
    [Parameter] public WorkspaceWorkflowSnapshot Workflow { get; set; }
    [Parameter] public string AttachmentId { get; set; } = "";
    [Parameter] public long LeaseGeneration { get; set; }
    private readonly WorkspaceFormBinding _binding = new WorkspaceFormBinding();
    private WorkspaceAboutDraft _draft;

    /// <summary>About is restored from the same data captured at invocation</summary>
    protected override void OnParametersSet()
    {
        if (this._binding.Adopt(this.Workflow, this.LeaseGeneration))
            this._draft = JsonSerializer.Deserialize<WorkspaceAboutDraft>(this.Workflow.Draft);
    }

    private System.Threading.Tasks.Task CloseAsync()
    {
        this._binding.Respond(this.WorkspaceService, new WorkspaceClientToken(this.AttachmentId, this.LeaseGeneration), true);
        return System.Threading.Tasks.Task.CompletedTask;
    }

    internal System.Threading.Tasks.Task<bool> FlushForHandoffAsync(CancellationToken cancellationToken) => this._binding.FlushAsync(this.WorkspaceService, new WorkspaceClientToken(this.AttachmentId, this.LeaseGeneration), this._binding.Current.Draft, cancellationToken);
}
