@namespace Bivium.Components.Shared
@inject IJSRuntime JSRuntime

<RadzenCard id="renamer-window" class="@("renamer-window bivium-radzen-renamer-window " + (this._isVisible ? "visible" : ""))">
    <RadzenStack class="renamer-titlebar rz-p-2" Gap="0.5rem" id="renamer-titlebar" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
        <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-m-0" Text="Advanced Rename" />
        <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" Size="ButtonSize.Small" Click="this.HandleClose" title="Close" aria-label="Close renamer" />
    </RadzenStack>

    <div class="renamer-body">
        <div class="renamer-file-list bivium-radzen-renamer-preview">
            <RadzenDataGrid Data="@this._previewItems" TItem="Bivium.Models.RenamePreviewItem" AllowSorting="false" AllowPaging="false"
                            AllowFiltering="false" Density="Density.Compact" EmptyText="No files">
                <Columns>
                    <RadzenDataGridColumn TItem="Bivium.Models.RenamePreviewItem" Property="OriginalName" Title="Original Name" />
                    <RadzenDataGridColumn TItem="Bivium.Models.RenamePreviewItem" Property="NewName" Title="New Name">
                        <Template Context="item">
                            <span>@item.NewName</span>
                            @if (item.HasConflict)
                            {
                                <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="Conflict" />
                            }
                            else if (item.HasError)
                            {
                                <RadzenBadge BadgeStyle="BadgeStyle.Warning" Text="Invalid name" />
                            }
                            else if (item.OriginalName != item.NewName)
                            {
                                <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="Changed" />
                            }
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </div>

        <div class="renamer-config bivium-radzen-renamer-config rz-p-3">
            <div class="renamer-method-selector">
                <RadzenLabel Text="Method" Component="renamer-method" />
                <RadzenDropDown TValue="Bivium.Models.RenameMethodType" Data="@(Enum.GetValues<Bivium.Models.RenameMethodType>())"
                                Name="renamer-method" @bind-Value="this._selectedMethodType" @bind-Value:after="this.HandleMethodTypeChanged" />
                <RadzenButton Text="Add" Icon="add" Size="ButtonSize.Small" Click="this.HandleAddMethod" />
            </div>

            <div class="renamer-params">
                @if (!string.IsNullOrEmpty(this._paramsError))
                {
                    <RadzenAlert AlertStyle="AlertStyle.Danger">@this._paramsError</RadzenAlert>
                }

                @if (this._selectedMethodType == Bivium.Models.RenameMethodType.Replace)
                {
                    <RadzenFormField Text="Search"><RadzenTextBox Name="renamer-search" @bind-Value="this._editingMethod.SearchText" @bind-Value:after="this.RecalculatePreview" Immediate="true" /></RadzenFormField>
                    <RadzenFormField Text="Replace"><RadzenTextBox Name="renamer-replace" @bind-Value="this._editingMethod.ReplaceText" @bind-Value:after="this.RecalculatePreview" Immediate="true" /></RadzenFormField>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem"><RadzenCheckBox Name="renamer-case-sensitive" TValue="bool" @bind-Value="this._editingMethod.CaseSensitive" @bind-Value:after="this.RecalculatePreview" /><RadzenLabel Text="Case sensitive" Component="renamer-case-sensitive" /></RadzenStack>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem"><RadzenCheckBox Name="renamer-use-regex" TValue="bool" @bind-Value="this._editingMethod.UseRegex" @bind-Value:after="this.RecalculatePreview" /><RadzenLabel Text="Use regex" Component="renamer-use-regex" /></RadzenStack>
                }
                else if (this._selectedMethodType == Bivium.Models.RenameMethodType.Add)
                {
                    <RadzenFormField Text="Text"><RadzenTextBox Name="renamer-insert-text" @bind-Value="this._editingMethod.InsertText" @bind-Value:after="this.RecalculatePreview" Immediate="true" /></RadzenFormField>
                    <RadzenFormField Text="Position"><RadzenNumeric Name="renamer-insert-position" TValue="int" @bind-Value="this._editingMethod.InsertPosition" @bind-Value:after="this.RecalculatePreview" /></RadzenFormField>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem"><RadzenCheckBox Name="renamer-from-end" TValue="bool" @bind-Value="this._editingMethod.FromEnd" @bind-Value:after="this.RecalculatePreview" /><RadzenLabel Text="From end" Component="renamer-from-end" /></RadzenStack>
                }
                else if (this._selectedMethodType == Bivium.Models.RenameMethodType.Remove)
                {
                    <RadzenFormField Text="Mode"><RadzenDropDown Name="renamer-remove-mode" TValue="bool" Data="@this.GetRemoveModes()" TextProperty="Value" ValueProperty="Key" @bind-Value="this._editingMethod.RemoveByPattern" @bind-Value:after="this.RecalculatePreview" /></RadzenFormField>
                    @if (!this._editingMethod.RemoveByPattern)
                    {
                        <RadzenFormField Text="Start"><RadzenNumeric Name="renamer-remove-start" TValue="int" @bind-Value="this._editingMethod.RemoveStartIndex" @bind-Value:after="this.RecalculatePreview" /></RadzenFormField>
                        <RadzenFormField Text="Count"><RadzenNumeric Name="renamer-remove-count" TValue="int" @bind-Value="this._editingMethod.RemoveCount" @bind-Value:after="this.RecalculatePreview" /></RadzenFormField>
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem"><RadzenCheckBox Name="renamer-remove-from-end" TValue="bool" @bind-Value="this._editingMethod.RemoveFromEnd" @bind-Value:after="this.RecalculatePreview" /><RadzenLabel Text="From end" Component="renamer-remove-from-end" /></RadzenStack>
                    }
                    else
                    {
                        <RadzenFormField Text="Pattern"><RadzenTextBox Name="renamer-remove-pattern" @bind-Value="this._editingMethod.RemovePattern" @bind-Value:after="this.RecalculatePreview" Immediate="true" /></RadzenFormField>
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem"><RadzenCheckBox Name="renamer-pattern-case" TValue="bool" @bind-Value="this._editingMethod.RemovePatternCaseSensitive" @bind-Value:after="this.RecalculatePreview" /><RadzenLabel Text="Case sensitive" Component="renamer-pattern-case" /></RadzenStack>
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem"><RadzenCheckBox Name="renamer-pattern-regex" TValue="bool" @bind-Value="this._editingMethod.RemovePatternUseRegex" @bind-Value:after="this.RecalculatePreview" /><RadzenLabel Text="Use regex" Component="renamer-pattern-regex" /></RadzenStack>
                    }
                }
                else if (this._selectedMethodType == Bivium.Models.RenameMethodType.NewCase)
                {
                    <RadzenFormField Text="Mode"><RadzenDropDown Name="renamer-case-mode" TValue="int" Data="@this.GetCaseModes()" TextProperty="Value" ValueProperty="Key" @bind-Value="this._editingMethod.CaseMode" @bind-Value:after="this.RecalculatePreview" /></RadzenFormField>
                    <RadzenFormField Text="Scope"><RadzenDropDown Name="renamer-case-scope" TValue="int" Data="@this.GetNameScopes()" TextProperty="Value" ValueProperty="Key" @bind-Value="this._editingMethod.CaseScope" @bind-Value:after="this.RecalculatePreview" /></RadzenFormField>
                }
                else if (this._selectedMethodType == Bivium.Models.RenameMethodType.NewName)
                {
                    <RadzenFormField Text="Pattern"><RadzenTextBox Name="renamer-name-pattern" @bind-Value="this._editingMethod.NamePattern" @bind-Value:after="this.RecalculatePreview" Immediate="true" /></RadzenFormField>
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0">Tags: &lt;Name&gt; &lt;Ext&gt; &lt;Folder&gt; &lt;Inc:start:step:pad&gt; &lt;Date:format&gt; &lt;Rand:min:max&gt;</RadzenText>
                }
                else if (this._selectedMethodType == Bivium.Models.RenameMethodType.Trim)
                {
                    <RadzenFormField Text="Chars"><RadzenTextBox Name="renamer-trim-chars" @bind-Value="this._editingMethod.TrimCharacters" @bind-Value:after="this.RecalculatePreview" Immediate="true" /></RadzenFormField>
                    <RadzenFormField Text="Location"><RadzenDropDown Name="renamer-trim-location" TValue="int" Data="@this.GetTrimLocations()" TextProperty="Value" ValueProperty="Key" @bind-Value="this._editingMethod.TrimLocation" @bind-Value:after="this.RecalculatePreview" /></RadzenFormField>
                    <RadzenFormField Text="Scope"><RadzenDropDown Name="renamer-trim-scope" TValue="int" Data="@this.GetNameScopes()" TextProperty="Value" ValueProperty="Key" @bind-Value="this._editingMethod.TrimScope" @bind-Value:after="this.RecalculatePreview" /></RadzenFormField>
                }
            </div>

            <RadzenText TextStyle="TextStyle.Subtitle2" class="renamer-stack-header rz-m-0">Methods (@this._methodStack.Count):</RadzenText>
            <RadzenCard Variant="Variant.Outlined" class="renamer-stack">
                @for (int idx = 0; idx < this._methodStack.Count; idx++)
                {
                    int i = idx;
                    Bivium.Models.RenameMethod method = this._methodStack[i];
                    <div class="renamer-stack-item rz-p-1">
                        <RadzenText TagName="TagName.Span" TextStyle="TextStyle.Body2" class="renamer-stack-item-name rz-m-0" title="@method.GetDisplayName()" Text="@method.GetDisplayName()" />
                        <div class="renamer-stack-item-actions">
                            @if (i > 0) { <RadzenButton Icon="arrow_upward" Size="ButtonSize.ExtraSmall" Click="@(() => this.HandleMoveUp(i))" title="Move up" aria-label="Move method up" /> }
                            @if (i < this._methodStack.Count - 1) { <RadzenButton Icon="arrow_downward" Size="ButtonSize.ExtraSmall" Click="@(() => this.HandleMoveDown(i))" title="Move down" aria-label="Move method down" /> }
                            <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.ExtraSmall" Click="@(() => this.HandleRemoveMethod(i))" title="Remove" aria-label="Remove method" />
                        </div>
                    </div>
                }
            </RadzenCard>
        </div>
    </div>

    <div class="renamer-statusbar bivium-radzen-renamer-statusbar rz-p-2">
        <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0" Text="@this._statusText" />
        <div class="renamer-statusbar-actions">
            <RadzenButton Text="Rename" Icon="drive_file_rename_outline" ButtonStyle="ButtonStyle.Primary" Click="this.HandleRename" Disabled="@(!this.CanRename())" />
            <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="this.HandleClose" />
        </div>
    </div>
     <div class="renamer-resize-handle" id="renamer-resize-handle"><RadzenIcon Icon="drag_handle" class="resize-grip-icon" aria-hidden="true" /></div>
</RadzenCard>
