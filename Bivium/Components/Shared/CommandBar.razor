<div class="command-bar">
    <span class="cmd-key" @onclick="async () => await this.OnCopy.InvokeAsync()"><span class="key-label">Ctrl+C</span> Copy</span>
    <span class="cmd-key" @onclick="async () => await this.OnCut.InvokeAsync()"><span class="key-label">Ctrl+X</span> Cut</span>
    <span class="cmd-key" @onclick="async () => await this.OnPaste.InvokeAsync()"><span class="key-label">Ctrl+V</span> Paste</span>
    <span class="cmd-key" @onclick="async () => await this.OnDelete.InvokeAsync()"><span class="key-label">Del</span> Delete</span>
    @if (!this.IsMultiSelection)
    {
        <span class="cmd-key" @onclick="async () => await this.OnRename.InvokeAsync()"><span class="key-label">F2</span> Rename</span>
    }
    <span class="cmd-key" @onclick="async () => await this.OnNewFolder.InvokeAsync()"><span class="key-label">Ctrl+Shift+N</span> New Folder</span>
    <span class="cmd-key" @onclick="async () => await this.OnRefresh.InvokeAsync()"><span class="key-label">F5</span> Refresh</span>
    @if (!this.IsMultiSelection)
    {
        <span class="cmd-key" @onclick="async () => await this.OnProperties.InvokeAsync()"><span class="key-label">Alt+Enter</span> Properties</span>
    }
    <span class="cmd-key" @onclick="async () => await this.OnTerminal.InvokeAsync()"><span class="key-label">F12</span> Terminal</span>
    <span class="cmd-key" style="margin-left: auto;" @onclick="async () => await this.OnAbout.InvokeAsync()"><span class="key-label">Ctrl+?</span> About</span>
</div>
