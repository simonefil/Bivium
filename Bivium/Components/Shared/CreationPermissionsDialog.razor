@namespace Bivium.Components.Shared

@if (this._isVisible)
{
    <PersistentModalShell Surface="creation-permissions" Label="Default Creation Permissions" OnCancel="this.HandleCancel" CanClose="@(!this._binding.Rejected)" OnContentRendered="this.HandleContentRenderedAsync">
        <div data-workspace-workflow-id="@this.Workflow.Id">
        <RadzenTemplateForm TItem="CreationPermissionsDialog" Data="this" Submit="@(_ => this.HandleSave())">
        <RadzenStack class="bivium-radzen-modal" Gap="1rem" Style="width:100%;max-height:calc(100dvh - 9rem);box-sizing:border-box;">
                 <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem"><RadzenCheckBox Name="creation-system-defaults" AriaLabel="Use system defaults" @bind-Value="this._useSystemDefaults" @bind-Value:after="this.PublishDraft" /><RadzenLabel Component="creation-system-defaults" Text="Use system defaults" /></RadzenStack>
                <RadzenRow>
                    <RadzenColumn Size="12" SizeMD="6"><RadzenFormField Text="Owner" Component="creation-owner" Style="width:100%;"><RadzenTextBox id="creation-owner" Name="creation-owner" @bind-Value="this._model.Owner" @bind-Value:after="this.PublishDraft" Immediate="true" Disabled="@this._useSystemDefaults" Style="width:100%;" /></RadzenFormField></RadzenColumn>
                    @if (this._isUnix)
                    {
                        <RadzenColumn Size="12" SizeMD="6"><RadzenFormField Text="Group" Component="creation-group" Style="width:100%;"><RadzenTextBox id="creation-group" Name="creation-group" @bind-Value="this._model.Group" @bind-Value:after="this.PublishDraft" Immediate="true" Disabled="@this._useSystemDefaults" Style="width:100%;" /></RadzenFormField></RadzenColumn>
                    }
                </RadzenRow>
                @if (this._isUnix)
                {
                    <RadzenRow>
                        <RadzenColumn Size="12" SizeMD="6">
                            <RadzenText TextStyle="TextStyle.Subtitle1" Text="@("Files (" + this.GetOctalString(this._model.FilePermissions) + ")")" />
                            <RadzenTable class="bivium-radzen-permissions" aria-label="File creation permissions">
                                <RadzenTableHeader>
                                    <RadzenTableHeaderRow><RadzenTableHeaderCell scope="col">Identity</RadzenTableHeaderCell><RadzenTableHeaderCell scope="col">Read</RadzenTableHeaderCell><RadzenTableHeaderCell scope="col">Write</RadzenTableHeaderCell><RadzenTableHeaderCell scope="col">Execute</RadzenTableHeaderCell></RadzenTableHeaderRow>
                                </RadzenTableHeader>
                                <RadzenTableBody>
                            <RadzenTableRow><RadzenTableHeaderCell scope="row">Owner</RadzenTableHeaderCell><RadzenTableCell><RadzenCheckBox @bind-Value="this._model.FilePermissions.OwnerRead" @bind-Value:after="this.PublishDraft" Disabled="@this._useSystemDefaults" AriaLabel="Files owner read" /></RadzenTableCell><RadzenTableCell><RadzenCheckBox @bind-Value="this._model.FilePermissions.OwnerWrite" @bind-Value:after="this.PublishDraft" Disabled="@this._useSystemDefaults" AriaLabel="Files owner write" /></RadzenTableCell><RadzenTableCell><RadzenCheckBox @bind-Value="this._model.FilePermissions.OwnerExecute" @bind-Value:after="this.PublishDraft" Disabled="@this._useSystemDefaults" AriaLabel="Files owner execute" /></RadzenTableCell></RadzenTableRow>
                            <RadzenTableRow><RadzenTableHeaderCell scope="row">Group</RadzenTableHeaderCell><RadzenTableCell><RadzenCheckBox @bind-Value="this._model.FilePermissions.GroupRead" @bind-Value:after="this.PublishDraft" Disabled="@this._useSystemDefaults" AriaLabel="Files group read" /></RadzenTableCell><RadzenTableCell><RadzenCheckBox @bind-Value="this._model.FilePermissions.GroupWrite" @bind-Value:after="this.PublishDraft" Disabled="@this._useSystemDefaults" AriaLabel="Files group write" /></RadzenTableCell><RadzenTableCell><RadzenCheckBox @bind-Value="this._model.FilePermissions.GroupExecute" @bind-Value:after="this.PublishDraft" Disabled="@this._useSystemDefaults" AriaLabel="Files group execute" /></RadzenTableCell></RadzenTableRow>
                            <RadzenTableRow><RadzenTableHeaderCell scope="row">Others</RadzenTableHeaderCell><RadzenTableCell><RadzenCheckBox @bind-Value="this._model.FilePermissions.OthersRead" @bind-Value:after="this.PublishDraft" Disabled="@this._useSystemDefaults" AriaLabel="Files others read" /></RadzenTableCell><RadzenTableCell><RadzenCheckBox @bind-Value="this._model.FilePermissions.OthersWrite" @bind-Value:after="this.PublishDraft" Disabled="@this._useSystemDefaults" AriaLabel="Files others write" /></RadzenTableCell><RadzenTableCell><RadzenCheckBox @bind-Value="this._model.FilePermissions.OthersExecute" @bind-Value:after="this.PublishDraft" Disabled="@this._useSystemDefaults" AriaLabel="Files others execute" /></RadzenTableCell></RadzenTableRow>
                                </RadzenTableBody>
                            </RadzenTable>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="6">
                            <RadzenText TextStyle="TextStyle.Subtitle1" Text="@("Folders (" + this.GetOctalString(this._model.DirectoryPermissions) + ")")" />
                            <RadzenTable class="bivium-radzen-permissions" aria-label="Folder creation permissions">
                                <RadzenTableHeader>
                                    <RadzenTableHeaderRow><RadzenTableHeaderCell scope="col">Identity</RadzenTableHeaderCell><RadzenTableHeaderCell scope="col">Read</RadzenTableHeaderCell><RadzenTableHeaderCell scope="col">Write</RadzenTableHeaderCell><RadzenTableHeaderCell scope="col">Execute</RadzenTableHeaderCell></RadzenTableHeaderRow>
                                </RadzenTableHeader>
                                <RadzenTableBody>
                            <RadzenTableRow><RadzenTableHeaderCell scope="row">Owner</RadzenTableHeaderCell><RadzenTableCell><RadzenCheckBox @bind-Value="this._model.DirectoryPermissions.OwnerRead" @bind-Value:after="this.PublishDraft" Disabled="@this._useSystemDefaults" AriaLabel="Folders owner read" /></RadzenTableCell><RadzenTableCell><RadzenCheckBox @bind-Value="this._model.DirectoryPermissions.OwnerWrite" @bind-Value:after="this.PublishDraft" Disabled="@this._useSystemDefaults" AriaLabel="Folders owner write" /></RadzenTableCell><RadzenTableCell><RadzenCheckBox @bind-Value="this._model.DirectoryPermissions.OwnerExecute" @bind-Value:after="this.PublishDraft" Disabled="@this._useSystemDefaults" AriaLabel="Folders owner execute" /></RadzenTableCell></RadzenTableRow>
                            <RadzenTableRow><RadzenTableHeaderCell scope="row">Group</RadzenTableHeaderCell><RadzenTableCell><RadzenCheckBox @bind-Value="this._model.DirectoryPermissions.GroupRead" @bind-Value:after="this.PublishDraft" Disabled="@this._useSystemDefaults" AriaLabel="Folders group read" /></RadzenTableCell><RadzenTableCell><RadzenCheckBox @bind-Value="this._model.DirectoryPermissions.GroupWrite" @bind-Value:after="this.PublishDraft" Disabled="@this._useSystemDefaults" AriaLabel="Folders group write" /></RadzenTableCell><RadzenTableCell><RadzenCheckBox @bind-Value="this._model.DirectoryPermissions.GroupExecute" @bind-Value:after="this.PublishDraft" Disabled="@this._useSystemDefaults" AriaLabel="Folders group execute" /></RadzenTableCell></RadzenTableRow>
                            <RadzenTableRow><RadzenTableHeaderCell scope="row">Others</RadzenTableHeaderCell><RadzenTableCell><RadzenCheckBox @bind-Value="this._model.DirectoryPermissions.OthersRead" @bind-Value:after="this.PublishDraft" Disabled="@this._useSystemDefaults" AriaLabel="Folders others read" /></RadzenTableCell><RadzenTableCell><RadzenCheckBox @bind-Value="this._model.DirectoryPermissions.OthersWrite" @bind-Value:after="this.PublishDraft" Disabled="@this._useSystemDefaults" AriaLabel="Folders others write" /></RadzenTableCell><RadzenTableCell><RadzenCheckBox @bind-Value="this._model.DirectoryPermissions.OthersExecute" @bind-Value:after="this.PublishDraft" Disabled="@this._useSystemDefaults" AriaLabel="Folders others execute" /></RadzenTableCell></RadzenTableRow>
                                </RadzenTableBody>
                            </RadzenTable>
                        </RadzenColumn>
                    </RadzenRow>
                }
                else
                {
                    <RadzenRow>
                        <RadzenColumn Size="12" SizeMD="6"><RadzenFieldset Text="Files"><RadzenStack Gap="0.5rem">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"><RadzenCheckBox Name="creation-file-readonly" AriaLabel="Files read-only" @bind-Value="this._model.FilePermissions.WinReadOnly" @bind-Value:after="this.PublishDraft" Disabled="@this._useSystemDefaults" /><RadzenLabel Component="creation-file-readonly" Text="Read-only" /></RadzenStack>
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"><RadzenCheckBox Name="creation-file-hidden" AriaLabel="Files hidden" @bind-Value="this._model.FilePermissions.WinHidden" @bind-Value:after="this.PublishDraft" Disabled="@this._useSystemDefaults" /><RadzenLabel Component="creation-file-hidden" Text="Hidden" /></RadzenStack>
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"><RadzenCheckBox Name="creation-file-system" AriaLabel="Files system" @bind-Value="this._model.FilePermissions.WinSystem" @bind-Value:after="this.PublishDraft" Disabled="@this._useSystemDefaults" /><RadzenLabel Component="creation-file-system" Text="System" /></RadzenStack>
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"><RadzenCheckBox Name="creation-file-archive" AriaLabel="Files archive" @bind-Value="this._model.FilePermissions.WinArchive" @bind-Value:after="this.PublishDraft" Disabled="@this._useSystemDefaults" /><RadzenLabel Component="creation-file-archive" Text="Archive" /></RadzenStack>
                        </RadzenStack></RadzenFieldset></RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="6"><RadzenFieldset Text="Folders"><RadzenStack Gap="0.5rem">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"><RadzenCheckBox Name="creation-folder-readonly" AriaLabel="Folders read-only" @bind-Value="this._model.DirectoryPermissions.WinReadOnly" @bind-Value:after="this.PublishDraft" Disabled="@this._useSystemDefaults" /><RadzenLabel Component="creation-folder-readonly" Text="Read-only" /></RadzenStack>
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"><RadzenCheckBox Name="creation-folder-hidden" AriaLabel="Folders hidden" @bind-Value="this._model.DirectoryPermissions.WinHidden" @bind-Value:after="this.PublishDraft" Disabled="@this._useSystemDefaults" /><RadzenLabel Component="creation-folder-hidden" Text="Hidden" /></RadzenStack>
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"><RadzenCheckBox Name="creation-folder-system" AriaLabel="Folders system" @bind-Value="this._model.DirectoryPermissions.WinSystem" @bind-Value:after="this.PublishDraft" Disabled="@this._useSystemDefaults" /><RadzenLabel Component="creation-folder-system" Text="System" /></RadzenStack>
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"><RadzenCheckBox Name="creation-folder-archive" AriaLabel="Folders archive" @bind-Value="this._model.DirectoryPermissions.WinArchive" @bind-Value:after="this.PublishDraft" Disabled="@this._useSystemDefaults" /><RadzenLabel Component="creation-folder-archive" Text="Archive" /></RadzenStack>
                        </RadzenStack></RadzenFieldset></RadzenColumn>
                    </RadzenRow>
                }
                @if (!string.IsNullOrEmpty(this._statusText))
                {
                    <RadzenAlert AlertStyle="AlertStyle.Danger">@this._statusText</RadzenAlert>
                }
                @if (!string.IsNullOrEmpty(this._binding.Error))
                {
                    <RadzenAlert AlertStyle="AlertStyle.Warning">@this._binding.Error</RadzenAlert>
                }
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" AlignItems="AlignItems.Center" Gap="0.75rem"><RadzenButton @ref="this._cancelButton" Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="this.HandleCancel" /><RadzenButton Text="Save" Icon="save" ButtonType="ButtonType.Submit" Disabled="@this._binding.Rejected" ButtonStyle="ButtonStyle.Primary" /></RadzenStack>
        </RadzenStack>
        </RadzenTemplateForm>
        </div>
    </PersistentModalShell>
}
