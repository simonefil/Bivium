@namespace Bivium.Components.Shared
@inject IJSRuntime JSRuntime

<RadzenCard id="editor-window" class="@("editor-window bivium-radzen-editor-window " + (this._isVisible ? "visible" : ""))">
    <RadzenStack class="editor-titlebar rz-p-2" Gap="0.5rem" id="editor-titlebar" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
        <RadzenText TextStyle="TextStyle.Subtitle2" class="editor-titlebar-title rz-m-0" Text="@("Edit: " + this._fileName)" />
        <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" Size="ButtonSize.Small" Click="this.HandleClose" title="Close" aria-label="Close editor" />
    </RadzenStack>

    <div id="monaco-container" class="editor-body"></div>

    <div class="editor-statusbar bivium-radzen-editor-statusbar rz-p-2">
        <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0" Text="@this._statusText" />
        <RadzenButton Text="Save" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="this.HandleSaveAsync" />
    </div>

     <div class="editor-resize-handle" id="editor-resize-handle"><RadzenIcon Icon="drag_handle" class="resize-grip-icon" aria-hidden="true" /></div>
</RadzenCard>
