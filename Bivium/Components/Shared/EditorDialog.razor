@namespace Bivium.Components.Shared
@inject IJSRuntime JSRuntime

<RadzenCard id="editor-window" Variant="Variant.Outlined" class="@("editor-window bivium-radzen-editor-window rz-p-0 " + (this._isVisible ? "visible" : ""))"
            Style="@this.WindowStyle" data-viewport-width="@this._window.ViewportWidth" data-viewport-height="@this._window.ViewportHeight" data-mru-order="@this._window.MruOrder" data-focus-target="@this._window.FocusTarget"
            role="dialog" aria-modal="false" aria-labelledby="editor-window-title">
    <RadzenStack class="@("editor-titlebar bivium-native-window-titlebar rz-p-2 " + (this.IsActive ? "rz-background-color-primary rz-color-on-primary" : ""))" Gap="0.5rem" id="editor-titlebar" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
        <RadzenStack class="bivium-native-window-titlebar-content" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
            <RadzenIcon Icon="edit_note" aria-hidden="true" />
            <RadzenText id="editor-window-title" TextStyle="TextStyle.Subtitle2" class="@("editor-titlebar-title bivium-native-window-title rz-m-0 " + (this.IsActive ? "rz-color-on-primary" : ""))" Text="@this.GetTitle()" />
        </RadzenStack>
        <RadzenStack class="bivium-native-window-titlebar-actions" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
            <RadzenButton Icon="minimize" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" Size="ButtonSize.Small" Click="this.MinimizeAsync" title="Minimize editor" aria-label="Minimize editor" />
            <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text" Size="ButtonSize.Small" Click="this.HandleClose" Disabled="@this._isSaving" title="Close" aria-label="Close editor" />
        </RadzenStack>
    </RadzenStack>

    <div id="monaco-container" class="editor-body"></div>

    <div class="editor-statusbar bivium-radzen-editor-statusbar rz-py-2 rz-ps-2">
        <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0" Text="@this._statusText" />
        <RadzenButton Text="Save" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="this.HandleSaveAsync" IsBusy="@this._isSaving" BusyText="Saving..." Disabled="@this._isSaving" data-focus-key="editor-save" />
    </div>

    <div class="editor-resize-handle" id="editor-resize-handle"><RadzenIcon Icon="drag_handle" class="resize-grip-icon" aria-hidden="true" /></div>
</RadzenCard>
