@namespace Bivium.Components.Shared
@implements IDisposable
@inject Bivium.Services.BiviumWorkspaceService WorkspaceService

@if (this.Workflow?.Kind is Bivium.Models.WorkspaceWorkflowKind.DeleteEntries or Bivium.Models.WorkspaceWorkflowKind.EditorAlert or Bivium.Models.WorkspaceWorkflowKind.ResetWorkspace && this.Workflow.Phase is Bivium.Models.WorkspaceWorkflowPhase.AwaitingConfirmation or Bivium.Models.WorkspaceWorkflowPhase.Failed)
{
    <PersistentModalShell Surface="confirm" @key="this.Workflow.QuestionId" Label="@this.GetTitle()" Width="min(92vw, 48rem)" CloseOnOverlayClick="true" OnCancel="@(() => this.RespondWorkspaceAsync(true))">
        <div data-workspace-workflow-id="@this.Workflow.Id">
            <RadzenStack Gap="1rem">
                @if (this.Workflow.Phase == Bivium.Models.WorkspaceWorkflowPhase.Failed)
                {
                    <RadzenAlert AlertStyle="AlertStyle.Danger" AllowClose="false" class="rz-m-0" Style="white-space: pre-wrap;">@this.Workflow.ErrorMessage</RadzenAlert>
                }
                else
                {
                    <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Div" class="rz-m-0" Style="white-space: pre-wrap;">@this.Workflow.InvocationParameters.Label</RadzenText>
                }
                @if (!string.IsNullOrEmpty(this._workspaceError))
                {
                    <RadzenAlert AlertStyle="AlertStyle.Warning" AllowClose="false" class="rz-m-0">@this._workspaceError</RadzenAlert>
                }
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" AlignItems="AlignItems.Center" Gap="0.75rem">
                    @if (this.Workflow.Phase == Bivium.Models.WorkspaceWorkflowPhase.AwaitingConfirmation)
                    {
                        @if (this.Workflow.Kind == Bivium.Models.WorkspaceWorkflowKind.EditorAlert)
                        {
                            <RadzenButton Text="OK" ButtonStyle="ButtonStyle.Primary" Click="@(() => this.RespondWorkspaceAsync(false))" />
                        }
                        else
                        {
                            <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="@(() => this.RespondWorkspaceAsync(true))" />
                            <RadzenButton Text="@(this.Workflow.Kind == Bivium.Models.WorkspaceWorkflowKind.ResetWorkspace ? "Reset" : "Delete")" ButtonStyle="ButtonStyle.Danger" Click="@(() => this.RespondWorkspaceAsync(false))" />
                        }
                    }
                    else
                    {
                        <RadzenButton Text="Close" ButtonStyle="ButtonStyle.Primary" Click="@(() => this.RespondWorkspaceAsync(true))" />
                    }
                </RadzenStack>
            </RadzenStack>
        </div>
    </PersistentModalShell>
}

@code {
    /// <summary>Server-owned question to project without re-invoking alert, delete or reset</summary>
    [Parameter] public Bivium.Models.WorkspaceWorkflowSnapshot Workflow { get; set; }
    /// <summary>Attachment of the current adapter</summary>
    [Parameter] public string AttachmentId { get; set; } = "";
    /// <summary>Observed authoritative generation</summary>
    [Parameter] public long LeaseGeneration { get; set; }
    /// <summary>UI feedback only after an explicitly consumed reset, never execution</summary>
    [Parameter] public EventCallback OnResetConfirmed { get; set; }
    /// <summary>Response captured for a single question, not a command delegate</summary>
    private Bivium.Models.WorkspaceWorkflowResponse _workspaceResponse;
    /// <summary>Identity of the mounted question</summary>
    private Guid _workspaceQuestionId;
    /// <summary>Response error, without automatic retry</summary>
    private string _workspaceError = "";
    /// <summary>Dispose releases only the adapter</summary>
    private bool _workspaceDisposed;

    /// <summary>Question hydration; no response or filesystem mutation</summary>
    protected override void OnParametersSet()
    {
        if (this.Workflow == null || this._workspaceDisposed || this._workspaceQuestionId == this.Workflow.QuestionId)
            return;
        this._workspaceQuestionId = this.Workflow.QuestionId;
        this._workspaceResponse = null;
        this._workspaceError = "";
    }

    /// <summary>Title of the question or of the failure, based on the captured command</summary>
    /// <returns>Dialog title</returns>
    private string GetTitle()
    {
        if (this.Workflow.Phase != Bivium.Models.WorkspaceWorkflowPhase.Failed)
            return this.Workflow.InvocationParameters.Title;
        return this.Workflow.Kind switch
        {
            Bivium.Models.WorkspaceWorkflowKind.DeleteEntries => "Delete failed",
            Bivium.Models.WorkspaceWorkflowKind.ResetWorkspace => "Reset failed",
            _ => this.Workflow.InvocationParameters.Title
        };
    }

    /// <summary>Responds with a stable identity; the selection stays in the server runtime</summary>
    /// <param name="cancelled">Explicit cancellation, never dispose</param>
    /// <returns>Completion of the adapter callback</returns>
    private async System.Threading.Tasks.Task RespondWorkspaceAsync(bool cancelled)
    {
        if (this._workspaceDisposed || this.Workflow?.Kind is not (Bivium.Models.WorkspaceWorkflowKind.DeleteEntries or Bivium.Models.WorkspaceWorkflowKind.EditorAlert or Bivium.Models.WorkspaceWorkflowKind.ResetWorkspace) || this.Workflow.Phase is not (Bivium.Models.WorkspaceWorkflowPhase.AwaitingConfirmation or Bivium.Models.WorkspaceWorkflowPhase.Failed))
            return;
        Bivium.Models.WorkspaceWorkflowKind kind = this.Workflow.Kind;
        if (this._workspaceResponse != null && this._workspaceResponse.Cancelled != cancelled)
            this._workspaceResponse = null;
        this._workspaceResponse ??= new Bivium.Models.WorkspaceWorkflowResponse(this.Workflow.Id, this.Workflow.Revision, this.Workflow.QuestionId, Guid.NewGuid(), cancelled, "");
        Bivium.Models.WorkspaceWorkflowResponseResult result = this.WorkspaceService.RespondToWorkflow(new Bivium.Models.WorkspaceClientToken(this.AttachmentId, this.LeaseGeneration), this._workspaceResponse);
        if (result is Bivium.Models.WorkspaceWorkflowResponseResult.Stale or Bivium.Models.WorkspaceWorkflowResponseResult.Denied)
            this._workspaceError = "This response was not accepted. The authoritative workflow is unchanged.";
        if (result == Bivium.Models.WorkspaceWorkflowResponseResult.Accepted && kind == Bivium.Models.WorkspaceWorkflowKind.ResetWorkspace && !cancelled)
            await this.OnResetConfirmed.InvokeAsync();
    }

    /// <summary>Confirms the immutable question; does not wait for the operation, if any, that was admitted</summary>
    /// <param name="cancellationToken">Drain lifecycle</param>
    /// <returns>True for the same acknowledged question or for its already admitted operation</returns>
    internal System.Threading.Tasks.Task<bool> FlushForHandoffAsync(System.Threading.CancellationToken cancellationToken)
    {
        cancellationToken.ThrowIfCancellationRequested();
        Bivium.Models.WorkspaceWorkflowSnapshot current = this.WorkspaceService.GetWorkflow(new Bivium.Models.WorkspaceClientToken(this.AttachmentId, this.LeaseGeneration));
        bool accepted = !this._workspaceDisposed && current != null && current.Id == this.Workflow?.Id
            && ((current.QuestionId == this.Workflow.QuestionId && current.Revision == this.Workflow.Revision) || current.Phase is Bivium.Models.WorkspaceWorkflowPhase.Running or Bivium.Models.WorkspaceWorkflowPhase.Succeeded or Bivium.Models.WorkspaceWorkflowPhase.Cancelled);
        return System.Threading.Tasks.Task.FromResult(accepted);
    }

    /// <summary>Detaches the adapter only; neither responds nor cancels the server-owned intent</summary>
    public void Dispose()
    {
        this._workspaceDisposed = true;
    }
}
