@namespace Bivium.Components.Shared

@if (this._isVisible)
{
    <PersistentModalShell Label="Compress" OnCancel="this.HandleCancel" OnContentRendered="this.HandleContentRenderedAsync">
        <RadzenStack class="bivium-radzen-modal" Gap="1rem" Style="width:100%;max-height:calc(100dvh - 9rem);box-sizing:border-box;">
                <RadzenFormField Text="Format" Component="compress-format" Style="width:100%;">
                    <RadzenDropDown TValue="Bivium.Models.ArchiveFormat" id="compress-format" Name="compress-format" Data="this._formats" TextProperty="Value" ValueProperty="Key" @bind-Value="this._selectedFormat" Change="this.HandleFormatChange" Style="width:100%;" />
                </RadzenFormField>
                <RadzenFormField Text="Output file name" Component="compress-output" Style="width:100%;">
                    <div @onkeydown="this.HandleKeyDown" @onkeydown:stopPropagation="true"><RadzenTextBox id="compress-output" Name="compress-output" @ref="this._outputNameElement" @bind-Value="this._outputName" Immediate="true" Style="width:100%;" /></div>
                </RadzenFormField>
                <div class="bivium-radzen-dialog-actions">
                    <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="this.HandleCancel" />
                    <RadzenButton Text="OK" ButtonStyle="ButtonStyle.Primary" Click="this.HandleConfirm" />
                </div>
        </RadzenStack>
    </PersistentModalShell>
}
