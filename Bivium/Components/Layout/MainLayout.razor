@namespace Bivium.Components.Layout
@inherits LayoutComponentBase

@* RadzenTheme reads Theme only in OnInitialized: later changes go through ThemeService (Commander) and a layout re-render does not undo them *@
<RadzenTheme Theme="@RadzenThemeCatalog.DEFAULT_THEME" />
<RadzenDialog />
<RadzenContextMenu />
<RadzenTooltip />
<RadzenNotification />

<main class="bivium-radzen">
    @Body
</main>
