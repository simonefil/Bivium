<script type="module" src="@Assets["Components/Layout/ReconnectModal.razor.js"]"></script>

<dialog id="components-reconnect-modal" data-nosnippet aria-labelledby="reconnect-title">
    <div class="components-reconnect-titlebar">
        <RadzenText id="reconnect-title" TextStyle="TextStyle.H6" TagName="TagName.H1" class="rz-m-0">Connection status</RadzenText>
    </div>
    <div class="components-reconnect-container">
        <div class="components-rejoining-animation" aria-hidden="true">
            <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" ShowValue="false" />
        </div>
        <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.P" class="components-reconnect-first-attempt-visible rz-m-0">
            Rejoining the server...
        </RadzenText>
        <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.P" class="components-reconnect-repeated-attempt-visible rz-m-0">
            Rejoin failed... trying again in <span id="components-seconds-to-next-attempt"></span> seconds.
        </RadzenText>
        <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.P" class="components-reconnect-failed-visible rz-m-0">
            Failed to rejoin.<br />Please retry or reload the page.
        </RadzenText>
        <RadzenButton id="components-reconnect-button" Text="Retry" ButtonType="ButtonType.Button" ButtonStyle="ButtonStyle.Primary" class="components-reconnect-failed-visible" />
        <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.P" class="components-pause-visible rz-m-0">
            The session has been paused by the server.
        </RadzenText>
        <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.P" class="components-resume-failed-visible rz-m-0">
            Failed to resume the session.<br />Please retry or reload the page.
        </RadzenText>
        <RadzenButton id="components-resume-button" Text="Resume" ButtonType="ButtonType.Button" ButtonStyle="ButtonStyle.Primary" class="components-pause-visible components-resume-failed-visible" />
    </div>
</dialog>
